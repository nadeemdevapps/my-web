---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://nadeem-dev-apps.pages.dev',
).toString();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={`${Astro.site ?? 'https://nadeem-dev-apps.pages.dev'}${base}logo.svg`}
    />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700;9..40,900&display=swap"
      rel="stylesheet"
    />
    {
      jsonLd?.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    <script is:inline>
      // Theme: light is the fresh-install default (like the app); the toggle
      // stores the choice in localStorage under the shared key 'nda-theme'
      // (same key as the main site and Tsumly). Dark is the design anchor.
      // A stored 'system' choice (set on another site) follows the OS.
      (function () {
        try {
          var mq = matchMedia('(prefers-color-scheme: dark)');
          function apply(mode) {
            var theme =
              mode === 'dark'
                ? 'dark'
                : mode === 'light'
                  ? 'light'
                  : mq.matches
                    ? 'dark'
                    : 'light';
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.setAttribute('data-theme-mode', mode);
          }
          var saved = localStorage.getItem('nda-theme');
          var mode =
            saved === 'dark' || saved === 'light' || saved === 'system'
              ? saved
              : 'light';
          apply(mode);
          mq.addEventListener('change', function () {
            if ((localStorage.getItem('nda-theme') || 'light') === 'system')
              apply('system');
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
