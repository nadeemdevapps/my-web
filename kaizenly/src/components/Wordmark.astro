---
// The KAIZENLY pixel wordmark, drawn in the app's own tile alphabet
// (PixelText.kt: 3x5 PixelFont, 0.9-cell letter gap, 14% cell gap).
// The centre tile of the Z is the brand accent — the same nod the app
// makes to the little orange block in the reference mark, now green.
// Ink tiles use currentColor so the mark follows the active theme.
interface Props {
  height?: number;
  class?: string;
}
const { height = 20, class: className = '' } = Astro.props;
---
