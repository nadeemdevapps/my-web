---
import KaizenLayout from '../layouts/KaizenLayout.astro';
import Wordmark from '../components/Wordmark.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteHome = 'https://nadeemdevapps.github.io/my-web/';

const faqs = [
  {
    q: 'What is Kaizenly?',
    a: 'Kaizenly is a strict focus guard for Android. You pick a duration and a bag — a named set of distracting apps — and every app in the active bag is blocked until the session ends. Leaving early costs parachutes, and there is no easy way out: that strictness is the point. All three bags, all six slots per bag, routines, and soundscapes are free. The only premium features are sessions up to 12 hours and silence during sessions.',
  },
  {
    q: 'How much does Kaizenly cost?',
    a: 'Everything is free to use right now. Bags, routines, soundscapes, and parachutes are all free in this version. Premium — sessions up to 12 hours (custom card) and silence / Do Not Disturb during sessions — is Rs 1,450 one-time and arrives with Play Billing. There is no purchase in the app today.',
  },
  {
    q: 'How do I get parachutes?',
    a: 'Parachutes are earned, never bought. Focus for at least 30 minutes of actual focus in a day and that day counts toward your parachute streak. The first 10 days pay double: day 3 earns +2, and by day 10 you have earned 20. After day 10 you earn +1 a day, with a +5 bonus at day 20. A missed day resets the streak to 0 — even if a Tower reserve saves your Tower streak. The full table is in the How to get parachutes section above.',
  },
  {
    q: 'What happens if I miss a day?',
    a: 'Two different streaks, two different rules. The Tower has 3 reserve blocks: a missed day spends one automatically, and 10 days in a row restores one. The parachute streak has no reserves — a missed day resets it to 0, even if a Tower reserve saved the Tower.',
  },
  {
    q: 'What if I open a blocked app during a session?',
    a: 'It bounces straight back. The accessibility service guards the screen: the notification shade closes, recents close, the power menu closes, and floating windows are dismissed. A 15-second watchdog and a guardian fallback bring the block back even if the process died, and the block survives a reboot.',
  },
  {
    q: 'Can I take a break during a session?',
    a: 'Yes — a 30-minute break, for 1 parachute, as many times as you need in a session. The clock freezes while you are on break and the block returns when the break ends. During a break, enforcement, the overlay, Do Not Disturb, and sound are all off.',
  },
  {
    q: 'Does Kaizenly store my data anywhere?',
    a: 'No. Kaizenly is local-first: sessions live in a local database on your device, and bags, routines, and settings live in on-device preferences. There is no Kaizenly account, no sign-up, and no server that receives your data. The app opts out of automatic cloud backup, so a fresh install starts empty and uninstalling wipes its local data. You can export and import a local JSON backup yourself.',
  },
  {
    q: 'Which apps stay open during a session?',
    a: 'The essentials stay open: messaging, the dialer, the camera, the alarm, the keyboard, and in-call screens. Everything in the active bag is blocked — everything else is yours.',
  },
  {
    q: 'What is the Tower?',
    a: 'The Tower is your streak, built. Five minutes of focus a day lays one block; seven blocks make a floor. Three reserve blocks sit beside it and are spent automatically on missed days, and ten days in a row restores one spent reserve. Reach day one hundred and you will find a surprise.',
  },
  {
    q: 'Can I use Kaizenly in the dark?',
    a: 'Yes. Kaizenly has Light, Automatic, and Dark themes. A fresh install starts in Light, and the toggle is in Settings. The dark theme is the design anchor — deep green-black surfaces with the vivid green accent.',
  },
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kaizenly',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Android',
  description:
    'A strict local-first focus guard for Android. Timed sessions, bags of blocked apps, routines, the Tower streak, and parachutes earned free by focusing — your data never leaves your device.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PKR' },
  author: { '@type': 'Person', name: 'Nadeem Mazhar' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Tower visual: three floors of seven blocks + three reserve blocks.
// Delays build the tower bottom-up as you scroll: floor 0 is the bottom
// floor, floor 3 is the reserve row. The visual stacks bottom-up via
// column-reverse, so the DOM order is progress, caption, reserve label,
// reserve row, then the floors.
const towerFloors = [7, 7, 7];
const towerReserves = 3;
const towerDelay = (floor: number, block: number) =>
  ((floor * 7 + block) * 0.07).toFixed(2);
---

<KaizenLayout
  title="Kaizenly — A little better, every day."
  description="Kaizenly is a strict local-first focus guard for Android. Timed sessions, bags of blocked apps, routines, the Tower streak, and parachutes earned free by focusing — your data never leaves your device."
  jsonLd={[softwareLd, faqLd]}
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="reveal">
        <img src={`${base}logo.svg`} alt="" width="76" height="76" class="hero-mark" />
        <h1>A little <span class="green">better</span>, every day.</h1>
        <p class="hero-lede">
          Kaizenly is a <strong>strict focus guard</strong> for Android. Pick a
          duration, pick a bag of distracting apps, and they stay blocked until
          the session ends. <strong>Leaving early costs parachutes</strong> —
          and there is no easy way out. That strictness is the point.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#focus">See how it works</a>
          <a class="btn btn-secondary" href="#parachutes">How to get parachutes</a>
        </div>
        <p class="hero-note">No download yet — the app is in development.</p>
      </div>

      <div class="hero-visual reveal reveal-scale" style="--d: 0.15s">
        <div class="float-pill"><span class="dot"></span> 24:59 left · 3 parachutes</div>
        <div class="phone" data-tilt>
          <div class="phone-handle" aria-hidden="true"></div>
          <div class="phone-wordmark">
            <Wordmark height={20} />
          </div>
          <div class="phone-timer"><span data-timer="45:00">45:00</span> <small>LEFT</small></div>
          <div class="phone-meta"><span>ENDS <b>6:45 PM</b></span><span>PARACHUTES <b>3</b></span></div>
          <div class="phone-bar"><i></i></div>
          <div class="phone-ends"><span>START 6:00 PM</span><span>45 MIN</span></div>
        </div>
        <div class="phone-chute">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11a9 9 0 0 1 18 0" /><path d="M5.5 11 12 19M18.5 11 12 19M12 11v8" /><rect x="10" y="19" width="4" height="3" rx="1" /></svg>
          +2 earned · day 3
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHY KAIZENLY ============ -->
  <section class="section" id="name">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">The name</span>
        <h2>Why Kaizenly?</h2>
        <p>
          Three words, one habit. <strong>Kai</strong> is change,
          <strong>Zen</strong> is calm, <strong>ly</strong> is daily.
        </p>
      </div>
      <div class="name-grid">
        <article class="name-card reveal" style="--d: 0s">
          <div class="glyph">Kai</div>
          <h3>Change</h3>
          <p>Small change, on purpose. Not an overhaul — one better session than yesterday.</p>
        </article>
        <article class="name-card reveal" style="--d: 0.1s">
          <div class="glyph"><span class="green">Zen</span></div>
          <h3>Calm</h3>
          <p>Focus without noise. The phone goes quiet, the apps go away, the mind settles.</p>
        </article>
        <article class="name-card reveal" style="--d: 0.2s">
          <div class="glyph">ly</div>
          <h3>Daily</h3>
          <p>Every day, not someday. The streak is the product — five minutes a day lays a block.</p>
        </article>
      </div>
      <p class="name-foot reveal">
        Kaizenly is <strong>Kaizen, daily</strong> — the Japanese idea that small,
        continuous improvement compounds into something real.
      </p>
    </div>
  </section>

  <!-- ============ FOCUS ============ -->
  <section class="section alt" id="focus">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Focus</span>
        <h2>One session. No way out.</h2>
        <p>
          Pick a bag, pick a time, slide to start. From that moment the apps
          in the bag are blocked — and <strong>leaving early costs parachutes</strong>.
        </p>
      </div>

      <div class="bags-visual reveal">
        <article class="bag active">
          <div class="bag-glyph">▦</div>
          <h4>Bag 1</h4>
          <div class="slots" aria-label="6 slots, 4 filled"><i></i><i></i><i></i><i></i><i class="empty"></i><i class="empty"></i></div>
          <p>Active bag · 4 of 6 slots filled</p>
        </article>
        <article class="bag">
          <div class="bag-glyph">▦</div>
          <h4>Bag 2</h4>
          <div class="slots" aria-label="6 slots, 3 filled"><i></i><i></i><i></i><i class="empty"></i><i class="empty"></i><i class="empty"></i></div>
          <p>3 of 6 slots filled</p>
        </article>
        <article class="bag">
          <div class="bag-glyph">▦</div>
          <h4>Bag 3</h4>
          <div class="slots" aria-label="6 slots, 2 filled"><i></i><i></i><i class="empty"></i><i class="empty"></i><i class="empty"></i><i class="empty"></i></div>
          <p>2 of 6 slots filled</p>
        </article>
      </div>

      <div class="focus-split">
        <article class="focus-panel reveal reveal-left">
          <h3>Presets — and the wheel</h3>
          <p>
            Start in one tap with <strong>15 minutes, 45 minutes, or 3 hours</strong>.
            Or spin the wheel: up to three of your own presets, from
            <strong>1 to 720 minutes</strong>. Sessions over 3 hours need at least
            one parachute on board — and stay premium-gated past the free 180 minutes.
          </p>
          <div class="preset-row">
            <span class="preset">15 min</span>
            <span class="preset on">45 min</span>
            <span class="preset">3 hours</span>
          </div>
          <div class="wheel" aria-hidden="true">
            <span class="wheel-dot"></span>
            <span class="wheel-value">45<small>MINUTES</small></span>
          </div>
          <div class="slide-start">Slide to start — <b>no accidental sessions</b></div>
        </article>

        <article class="focus-panel reveal reveal-right">
          <h3>Hold to extend</h3>
          <p>
            Need more time? Hold for three seconds and the session grows by
            <strong>15 minutes</strong> — up to +60 minutes per session. Extending
            needs a parachute on board (it is not consumed). The session can even
            stretch to the next routine window, capped at 12 hours.
          </p>
          <div class="slide-start">Hold 3s → <b>+15 min</b> · up to +60 per session</div>
          <h3 style="margin-top: 28px">Routine-aware sessions</h3>
          <p>
            A session that would end inside a routine window stretches to the end
            of that window instead — when a routine is enabled and you have a
            parachute. One focus, no gaps.
          </p>
        </article>
      </div>

      <div class="block-mock" style="margin-top: 20px">
        <div class="block-screen reveal reveal-left" data-tilt>
          <div class="bs-label">SESSION ACTIVE</div>
          <div class="bs-timer"><span data-timer="24:59">24:59</span></div>
          <div class="bs-ends">ENDS <b>6:45 PM</b> · 45 MIN SESSION</div>
          <div class="bs-row">
            <div class="bs-chip">PARACHUTES<b>3</b></div>
            <div class="bs-chip">BREAK<b>30 min</b></div>
            <div class="bs-chip">SOUND<b>Rain</b></div>
          </div>
        </div>
        <article class="block-copy reveal reveal-right">
          <h3>The block screen</h3>
          <p>
            While a session runs, the block screen is the only thing between you
            and the apps. It shows the countdown, the end time, and your parachutes —
            and after three seconds of idle it rests, dimming to a quiet clock.
          </p>
          <ul>
            <li><strong>Essentials stay open</strong> — messaging, dialer, camera, alarm, keyboard, in-call.</li>
            <li><strong>Enforcement is real</strong> — shade, recents, and the power menu close; floating windows are dismissed; a 15-second watchdog and a guardian fallback bring the block back even if the process died.</li>
            <li><strong>Up to 3 × 60-second settings passes</strong> per session for the things you genuinely need.</li>
          </ul>
        </article>
      </div>

      <div class="feature-grid" style="margin-top: 20px">
        <article class="feature-card reveal" style="--d: 0s">
          <div class="icon">●</div>
          <h3>The floating pill</h3>
          <p>
            A small pill floats over everything while a session runs — time left
            and parachutes at a glance. Tap it to open the app. It never gets in
            the way of the essentials.
          </p>
        </article>
        <article class="feature-card reveal" style="--d: 0.08s">
          <div class="icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11a9 9 0 0 1 18 0" /><path d="M5.5 11 12 19M18.5 11 12 19M12 11v8" /><rect x="10" y="19" width="4" height="3" rx="1" /></svg>
          </div>
          <h3>Parachutes</h3>
          <p>
            Emergency exits that end a block early. A break costs
            <strong> 1</strong>; exiting early costs
            <strong> 1 + 1 per hour left</strong> (minimum 2). Earned free by
            focusing — never bought.
          </p>
          <span class="tag">Earned free, never sold</span>
        </article>
        <article class="feature-card reveal" style="--d: 0.16s">
          <div class="icon">◐</div>
          <h3>The 30-minute break</h3>
          <p>
            One parachute buys a 30-minute break, as many times as you need in a
            session. The clock freezes; the block returns when the break ends.
            Enforcement, sound, and Do Not Disturb rest during the break.
          </p>
        </article>
        <article class="feature-card reveal" style="--d: 0s">
          <div class="icon">♪</div>
          <h3>Soundscapes</h3>
          <p>
            <strong>Rain, Waves, White Noise, and City</strong> — four sounds
            generated live on your device, never streamed, never auto-played.
            They fade in and out with the session. All four are free.
          </p>
          <span class="tag">All 4 sounds free</span>
        </article>
        <article class="feature-card reveal" style="--d: 0.08s">
          <div class="icon">▣</div>
          <h3>Block screen, done right</h3>
          <p>
            The countdown, the end time, your parachutes — and a celebration when
            you finish. <strong>DONE</strong> in white tiles, <strong>SOS</strong> in
            green when you bailed. Share the card as a PNG; the done pill is the
            only way out.
          </p>
        </article>
        <article class="feature-card reveal" style="--d: 0.16s">
          <div class="icon">✦</div>
          <h3>Boot restore</h3>
          <p>
            Restart the phone mid-session and the block comes back. The watchdog,
            the guardian fallback, and boot restore mean a session ends when the
            timer ends — not when the phone does.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ ROUTINES & STREAKS ============ -->
  <section class="section" id="routines">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Routines &amp; streaks</span>
        <h2>Set it once. Focus on schedule.</h2>
        <p>
          Up to <strong>three routines</strong> — a bag, a time window, days of the
          week — and Kaizenly starts the block for you. Routines are
          <strong> free</strong>, including each routine using its own bag.
        </p>
      </div>
      <div class="feature-grid two">
        <article class="feature-card reveal reveal-left">
          <div class="icon">◷</div>
          <h3>Routines that start themselves</h3>
          <p>
            A routine needs at least one parachute to enable — the safety net
            for an automatic block. Overlapping routines ask before they both
            fire, and each routine can use <strong>its own bag</strong>: the bag
            in hand is restored when the routine session ends.
          </p>
          <span class="tag">3 routines free</span>
        </article>
        <article class="feature-card reveal reveal-right">
          <div class="icon">▲</div>
          <h3>The daily streak</h3>
          <p>
            <strong>One minute a day</strong> keeps the streak alive — five minutes
            on your very first day. Weeks run Monday to Sunday, and a gentle
            evening reminder at <strong>8:30 PM</strong> nudges you if today is
            still empty: “Five minutes of session lay today's block.”
          </p>
          <span class="tag">1 min a day keeps it alive</span>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ THE TOWER ============ -->
  <section class="section alt" id="tower">
    <div class="container">
      <div class="tower-wrap">
        <div class="tower-visual" data-tower>
          <div class="tower-progress" aria-hidden="true"></div>
          <div class="tower-caption">Scroll — the Tower builds block by block</div>
          <div class="tower-reserve-label">3 reserve blocks</div>
          <div class="tower-floor">
            {Array.from({ length: towerReserves }).map((_, i) => (
              <div class="tower-block reserve" style={`--d: ${towerDelay(3, i)}s`}></div>
            ))}
          </div>
          {
            towerFloors.map((blocks, fi) => (
              <div class="tower-floor">
                {Array.from({ length: blocks }).map((_, bi) => (
                  <div class="tower-block" style={`--d: ${towerDelay(fi, bi)}s`}></div>
                ))}
              </div>
            ))
          }
        </div>
        <div class="tower-copy reveal reveal-right">
          <span class="kicker">The Tower</span>
          <h3>Your streak, built.</h3>
          <p>
            Five minutes of focus a day lays <strong>one block</strong>. Seven
            blocks make a <strong>floor</strong>. The Tower grows as you do —
            and you can watch it grow, floor by floor.
          </p>
          <p>
            Life happens: <strong>three reserve blocks</strong> sit beside the
            Tower and are spent automatically on missed days. Ten days in a row
            restores one spent reserve, up to three. And if you reach
            <strong> day one hundred</strong>, you will find a surprise.
          </p>
          <div class="tower-stats">
            <div class="tower-stat"><b>5 min</b><span>lays a block</span></div>
            <div class="tower-stat"><b>7</b><span>blocks make a floor</span></div>
            <div class="tower-stat"><b>3</b><span>reserve blocks</span></div>
            <div class="tower-stat"><b>Day 100</b><span>a surprise</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="section" id="stats">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Stats</span>
        <h2>Proof, not promises.</h2>
        <p>
          Day, month, and year — every session you finished, in one place.
          Sessions under five seconds are not recorded; the rest is all yours.
        </p>
      </div>
      <div class="stat-panels">
        <article class="stat-panel reveal" style="--d: 0s">
          <div class="range">DAY</div>
          <div class="stat-bars" aria-hidden="true"><i style="height: 34%"></i><i style="height: 62%"></i><i style="height: 48%"></i><i style="height: 84%"></i><i style="height: 56%"></i><i style="height: 100%"></i><i style="height: 40%"></i></div>
          <p>Today's focus, session by session.</p>
        </article>
        <article class="stat-panel reveal" style="--d: 0.1s">
          <div class="range">MONTH</div>
          <div class="stat-bars" aria-hidden="true"><i style="height: 52%"></i><i style="height: 70%"></i><i style="height: 44%"></i><i style="height: 88%"></i><i style="height: 66%"></i><i style="height: 92%"></i><i style="height: 58%"></i></div>
          <p>This month's total — the rotary wheel and stepper make it easy to browse.</p>
        </article>
        <article class="stat-panel reveal" style="--d: 0.2s">
          <div class="range">YEAR</div>
          <div class="stat-bars" aria-hidden="true"><i style="height: 46%"></i><i style="height: 60%"></i><i style="height: 78%"></i><i style="height: 54%"></i><i style="height: 96%"></i><i style="height: 70%"></i><i style="height: 82%"></i></div>
          <p>The year so far. The Tower remembers what the calendar forgets.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ WIDGETS ============ -->
  <section class="section alt" id="widgets">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Widgets</span>
        <h2>Focus, from the home screen.</h2>
        <p>
          Two widgets, no app-opening required. Start a session or check the
          streak right from where your phone already is.
        </p>
      </div>
      <div class="widget-grid">
        <article class="widget-mock reveal reveal-left">
          <h3>Preset widget</h3>
          <p class="widget-sub">Up to three of your presets · 1–720 minutes</p>
          <div class="widget-presets">
            <span>15</span>
            <span class="on">45</span>
            <span>180</span>
          </div>
          <p class="widget-sub" style="margin-top: 14px">Tap a preset, slide, focus. The green one is ready.</p>
        </article>
        <article class="widget-mock reveal reveal-right">
          <h3>Streak widget</h3>
          <p class="widget-sub">The last 28 days · 4 week rows</p>
          <div class="streak-weeks" aria-hidden="true">
            <div class="week"><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i></div>
            <div class="week"><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i></div>
            <div class="week"><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i></div>
            <div class="week"><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i><i class="today"></i><i></i></div>
          </div>
          <p class="widget-sub" style="margin-top: 14px">Today is ringed. Tomorrow is empty — until you fill it.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ SETTINGS & BACKUP ============ -->
  <section class="section" id="settings">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Settings &amp; backup</span>
        <h2>Yours, the way you like it.</h2>
        <p>
          Light, Automatic, or Dark — a fresh install starts in Light. Haptics
          on or off. And a backup that is a plain JSON file, yours to keep.
        </p>
      </div>
      <div class="feature-grid">
        <article class="feature-card reveal" style="--d: 0s">
          <div class="icon">◐</div>
          <h3>Theme</h3>
          <p>
            Three cards — <strong>Light, Automatic, Dark</strong>. Dark is the
            design anchor: deep green-black surfaces with the vivid green accent.
          </p>
        </article>
        <article class="feature-card reveal" style="--d: 0.08s">
          <div class="icon">✦</div>
          <h3>Haptics</h3>
          <p>
            One global switch. Turn it off and every vibration in the app stops —
            turn it on and you feel it immediately.
          </p>
        </article>
        <article class="feature-card reveal" style="--d: 0.16s">
          <div class="icon">▣</div>
          <h3>Local backup</h3>
          <p>
            Export a <strong>JSON backup</strong> and import it back with a
            confirm step. It is validated before it is written, and a live session
            is never carried over. No drive, no password, no upload.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ PREMIUM / FREE ============ -->
  <section class="section alt" id="premium">
    <div class="container">
