---
import KaizenLayout from '../layouts/KaizenLayout.astro';
import Wordmark from '../components/Wordmark.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteHome = 'https://nadeemdevapps.github.io/my-web/';

const faqs = [
  {
    q: 'What is Kaizenly?',
    a: 'Kaizenly is a strict focus guard for Android. You pick a duration and a bag — a named set of distracting apps — and every app in the active bag is blocked until the session ends. Leaving early costs parachutes, and there is no easy way out: that strictness is the point. All three bags, all six slots per bag, routines, and soundscapes are free — and so are sessions up to 12 hours (custom card) and silence during sessions. Everything in the app is free.',
  },
  {
    q: 'How much does Kaizenly cost?',
    a: 'Everything is free. Bags, routines, soundscapes, and parachutes are all free — and so are the custom card, sessions up to 12 hours, and silence / Do Not Disturb during sessions. There is no purchase in the app, and none is planned.',
  },
  {
    q: 'How do I get parachutes?',
    a: 'Parachutes are earned, never bought. Focus for at least 30 minutes of actual focus in a day and that day counts toward your parachute streak. The first 10 days pay double: day 3 earns +2, and by day 10 you have earned 20. After day 10 you earn +1 a day, with a +5 bonus at day 20. A missed day resets the streak to 0 — even if a Tower reserve saves your Tower streak. The full rule and table are on the Features page.',
  },
  {
    q: 'What happens if I miss a day?',
    a: 'Two different streaks, two different rules. The Tower has 3 reserve blocks: a missed day spends one automatically, and 10 days in a row restores one. The parachute streak has no reserves — a missed day resets it to 0, even if a Tower reserve saved the Tower.',
  },
  {
    q: 'What if I open a blocked app during a session?',
    a: 'It bounces straight back. The notification shade closes, recents close, the power menu closes, and floating windows are dismissed. The block comes back on its own even if the app was closed, and it survives a reboot.',
  },
  {
    q: 'Can I take a break during a session?',
    a: 'Yes — a 30-minute break, for 1 parachute, as many times as you need in a session. The clock freezes while you are on break and the block returns when the break ends. During a break, enforcement, the overlay, Do Not Disturb, and sound are all off.',
  },
  {
    q: 'Does Kaizenly store my data anywhere?',
    a: 'No. Kaizenly is local-first: sessions live in a local database on your device, and bags, routines, and settings live in on-device preferences. There is no Kaizenly account, no sign-up, and no server that receives your data. The app opts out of automatic cloud backup, so a fresh install starts empty and uninstalling wipes its local data. You can export and import a local JSON backup yourself.',
  },
  {
    q: 'Which apps stay open during a session?',
    a: 'The essentials stay open: messaging, the dialer, the camera, the alarm, the keyboard, and in-call screens. Everything in the active bag is blocked — everything else is yours.',
  },
  {
    q: 'What is the Tower?',
    a: 'The Tower is your streak, built. Five minutes of focus a day lays one block; seven blocks make a floor. Three reserve blocks sit beside it and are spent automatically on missed days, and ten days in a row restores one spent reserve. Reach day one hundred and you will find a surprise.',
  },
  {
    q: 'Can I use Kaizenly in the dark?',
    a: 'Yes. Kaizenly has Light, Automatic, and Dark themes. A fresh install starts in Light, and the toggle is in Settings. The dark theme is the design anchor — deep green-black surfaces with the vivid green accent.',
  },
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kaizenly',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Android',
  description:
    'A strict local-first focus guard for Android. Timed sessions, bags of blocked apps, routines, the Tower streak, and parachutes earned free by focusing — your data never leaves your device.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PKR' },
  author: { '@type': 'Person', name: 'Nadeem Mazhar' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const highlights = [
  {
    icon: '●',
    title: 'Focus sessions',
    body: 'Bags, presets, the wheel, and a block screen that does not let go — with breaks and parachutes for when life interrupts.',
    href: `${base}features/#focus`,
  },
  {
    icon: '◷',
    title: 'Routines',
    body: 'Three routines that start themselves — on schedule, on the days you choose, each with its own bag.',
    href: `${base}features/#routines`,
  },
  {
    icon: '▲',
    title: 'The Tower',
    body: 'Five minutes a day lays a block. Seven blocks make a floor. Your streak, built where you can watch it grow.',
    href: `${base}features/#tower`,
  },
  {
    icon: '♪',
    title: 'Parachutes, earned free',
    body: 'Focus for 30 minutes a day and the streak pays you in parachutes — the first 10 days pay double. Never sold.',
    href: `${base}features/#parachutes`,
  },
];
---

<KaizenLayout
  title="Kaizenly — A little better, every day."
  description="Kaizenly is a strict local-first focus guard for Android. Timed sessions, bags of blocked apps, routines, the Tower streak, and parachutes earned free by focusing — your data never leaves your device."
  jsonLd={[softwareLd, faqLd]}
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="reveal">
        <img src={`${base}logo.svg`} alt="" width="76" height="76" class="hero-mark" />
        <h1>A little <span class="green">better</span>, every day.</h1>
        <p class="hero-lede">
          Kaizenly is a <strong>strict focus guard</strong> for Android. Pick a
          duration, pick a bag of distracting apps, and they stay blocked until
          the session ends. <strong>Leaving early costs parachutes</strong> —
          and there is no easy way out. That strictness is the point.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={`${base}features/#focus`}>See how it works</a>
          <a class="btn btn-secondary" href={`${base}features/#parachutes`}>How to get parachutes</a>
        </div>
        <p class="hero-note">No download yet — the app is in development.</p>
      </div>

      <div class="hero-visual reveal reveal-scale" style="--d: 0.15s">
        <div class="float-pill"><span class="dot"></span> 24:59 left · 3 parachutes</div>
        <div class="phone" data-tilt>
          <div class="phone-handle" aria-hidden="true"></div>
          <div class="phone-wordmark">
            <Wordmark height={20} />
          </div>
          <div class="phone-timer"><span data-timer="45:00">45:00</span> <small>LEFT</small></div>
          <div class="phone-meta"><span>ENDS <b>6:45 PM</b></span><span>PARACHUTES <b>3</b></span></div>
          <div class="phone-bar"><i></i></div>
          <div class="phone-ends"><span>START 6:00 PM</span><span>45 MIN</span></div>
        </div>
        <div class="phone-chute">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11a9 9 0 0 1 18 0" /><path d="M5.5 11 12 19M18.5 11 12 19M12 11v8" /><rect x="10" y="19" width="4" height="3" rx="1" /></svg>
          +2 earned · day 3
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHY KAIZENLY ============ -->
  <section class="section" id="name">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">The name</span>
        <h2>Why Kaizenly?</h2>
        <p>
          Three words, one habit. <strong>Kai</strong> is change,
          <strong>Zen</strong> is calm, <strong>ly</strong> is daily.
        </p>
      </div>
      <div class="name-grid">
        <article class="name-card reveal" style="--d: 0s">
          <div class="glyph">Kai</div>
          <h3>Change</h3>
          <p>Small change, on purpose. Not an overhaul — one better session than yesterday.</p>
        </article>
        <article class="name-card reveal" style="--d: 0.1s">
          <div class="glyph"><span class="green">Zen</span></div>
          <h3>Calm</h3>
          <p>Focus without noise. The phone goes quiet, the apps go away, the mind settles.</p>
        </article>
        <article class="name-card reveal" style="--d: 0.2s">
          <div class="glyph">ly</div>
          <h3>Daily</h3>
          <p>Every day, not someday. The streak is the product — five minutes a day lays a block.</p>
        </article>
      </div>
      <p class="name-foot reveal">
        Kaizenly is <strong>Kaizen, daily</strong> — the Japanese idea that small,
        continuous improvement compounds into something real.
      </p>
    </div>
  </section>

  <!-- ============ HIGHLIGHTS ============ -->
  <section class="section alt" id="highlights">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">What it does</span>
        <h2>Strict where it matters.</h2>
        <p>
          Four things, done properly. The full detail — every rule, every
          limit, every edge case — is on the Features page.
        </p>
      </div>
      <div class="feature-grid">
        {
          highlights.map((h, i) => (
            <article class="feature-card reveal" style={`--d: ${i * 0.08}s`}>
              <div class="icon">{h.icon}</div>
              <h3>{h.title}</h3>
              <p>{h.body}</p>
              <p style="margin-top: 14px">
                <a class="text-link" href={h.href}>Learn more →</a>
              </p>
            </article>
          ))
        }
      </div>
      <p class="reveal" style="margin-top: 28px; text-align: center;">
        <a class="btn btn-secondary" href={`${base}features/`}>All features, in detail →</a>
      </p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section" id="faq">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">FAQ</span>
        <h2>Kaizenly, answered.</h2>
        <p>The questions people actually ask — answered plainly.</p>
      </div>
      <div class="faq-list">
        {
          faqs.map((f, i) => (
            <details class="faq-item reveal" style={`--d: ${i * 0.04}s`}>
              <summary>{f.q}</summary>
              <div class="faq-body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ LOCAL-FIRST BAND ============ -->
  <section class="band">
    <div class="container reveal">
      <h2>Your focus belongs to <span class="green">you</span>.</h2>
      <p>
        Kaizenly has <strong>no account, no sign-up, and no server</strong>.
        Your sessions live in a local database on your device; your bags,
        routines, and settings live in on-device preferences. The app opts out
        of automatic cloud backup — a fresh install starts empty, and
        uninstalling wipes its local data. Your focus data is yours, and it
        stays where it was made.
      </p>
      <div class="band-points">
        <span>No account</span>
        <span>No sign-up</span>
        <span>No server</span>
        <span>No trackers</span>
        <span>Local backup, yours to keep</span>
      </div>
    </div>
  </section>

  <!-- ============ ABOUT / DEVELOPER ============ -->
  <section class="section" id="about">
    <div class="container">
      <div class="about-card reveal">
        <div class="about-mark" aria-hidden="true">K</div>
        <div>
          <h2>Built by Nadeem.</h2>
          <p>
            Kaizenly is built by <strong>Nadeem Mazhar</strong>, a solo developer,
            as <strong>Nadeem Dev Apps</strong>. It started as his own
            problem — a phone that would not stay down — and it is built the way
            he builds everything: local-first, strict where it matters, and honest
            about what it does.
          </p>
          <a class="about-link" href={siteHome}>More from Nadeem Dev Apps →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MOTION SCRIPT ============ -->
  <script>
    (function () {
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveal on scroll — IntersectionObserver (works everywhere);
      // CSS view-timeline handles the decorative scroll-linked bits.
      var revealEls = document.querySelectorAll('.reveal, .reward-table tbody tr');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealEls.forEach(function (el) { el.classList.add('in'); });
      } else {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        revealEls.forEach(function (el) { io.observe(el); });
      }

      // The Tower builds block-by-block as it scrolls into view.
      var tower = document.querySelector('[data-tower]');
      if (tower) {
        if (reduceMotion || !('IntersectionObserver' in window)) {
          tower.classList.add('in');
        } else {
          var tio = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  tower.classList.add('in');
                  tio.disconnect();
                }
              });
            },
            { threshold: 0.25 }
          );
          tio.observe(tower);
        }
      }

      // 3D tilt on scroll — small rotateX/rotateY on the phone visuals,
      // driven by each element's position relative to the viewport centre.
      var tiltEls = document.querySelectorAll('[data-tilt]');
      if (!reduceMotion && tiltEls.length) {
        var ticking = false;
        var onScroll = function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            var vh = window.innerHeight;
            tiltEls.forEach(function (el) {
              var r = el.getBoundingClientRect();
              if (r.bottom < -80 || r.top > vh + 80) return;
              var progress = (r.top + r.height / 2 - vh / 2) / vh; // -0.5 .. 0.5
              var rx = Math.max(-6, Math.min(6, progress * 10));
              var ry = Math.max(-5, Math.min(5, -progress * 8));
              el.style.setProperty('--rx', rx.toFixed(2) + 'deg');
              el.style.setProperty('--ry', ry.toFixed(2) + 'deg');
            });
            ticking = false;
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // The timers tick — the block screen, alive.
      if (!reduceMotion) {
        document.querySelectorAll('[data-timer]').forEach(function (el) {
          var parts = (el.getAttribute('data-timer') || '45:00').split(':');
          var total = parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
          var start = total;
          setInterval(function () {
            total = total > 0 ? total - 1 : start;
            var m = Math.floor(total / 60);
            var s = total % 60;
            el.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
          }, 1000);
        });
      }
    })();
  </script>
</KaizenLayout>
