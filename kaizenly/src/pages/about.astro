---
import KaizenLayout from '../layouts/KaizenLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteHome = 'https://nadeemdevapps.github.io/my-web/';
const aboutUrl = 'https://nadeemdevapps.github.io/my-web/products/kaizenly/about/';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${aboutUrl}#nadeem`,
  name: 'Nadeem Mazhar',
  jobTitle: 'Solo Developer',
  description:
    'Solo developer. Builds websites, Windows apps, Android apps, and backends — local-first or cloud, whichever the project needs — with AI doing the heavy lifting under his direction.',
  url: aboutUrl,
  sameAs: ['https://github.com/nadeemdevapps'],
};

const nameParts = [
  {
    title: 'Kai — Change',
    body: 'Small change, on purpose. Not an overhaul — one better session than yesterday.',
  },
  {
    title: 'Zen — Calm',
    body: 'Focus without noise. The phone goes quiet, the apps go away, the mind settles.',
  },
  {
    title: 'ly — Daily',
    body: 'Every day, not someday. The streak is the product — five minutes a day lays a block.',
  },
];

const philosophy = [
  {
    title: 'Strict about the session',
    body: 'Once a session starts, the block does not let go. Leaving early costs a parachute — that is the deal, and the app says so up front.',
  },
  {
    title: 'Small steps, every day',
    body: 'Five minutes a day lays a block; seven blocks make a floor. You do not need a perfect day — you need one focused session.',
  },
  {
    title: 'No guilt, no pressure',
    body: 'The app never shames you for a missed day. Progress is quiet and daily — not perfectionism, not pressure.',
  },
];
---

<KaizenLayout
  title="About Kaizenly — Built for a phone that would not stay down"
  description="Kaizenly started as one developer's own problem: a phone that would not stay down. Strict where it matters, local-first, and free — small steps, every day."
  jsonLd={[personLd]}
>
  <!-- ============ THE STORY ============ -->
  <section class="section" id="top">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">About</span>
        <h2>Built for a phone that would not stay down.</h2>
        <p>
          Kaizenly started as my own problem. I built it first for myself,
          after trying a lot of focus apps and never finding one that was
          both <strong>strict and private</strong>. Most of them did one thing
          well — a timer, or a blocker — but they asked me to log in, pulled
          my data to a server, or wrapped everything in ads and pressure.
        </p>
        <p style="margin-top: 16px;">
          I wanted one thing: a guard that <strong>holds the line</strong>,
          with everything staying on my own device. There is no backend and
          no server to pay for — that constraint became the app's biggest
          strength. Kaizenly is <strong>local-first by design</strong>: no
          account, no sign-up, no analytics, no ads. Your sessions, bags,
          routines, and settings live on your phone, and the only backup is
          a file you export yourself.
        </p>
        <p style="margin-top: 16px;">
          Everything is <strong>free</strong> — sounds, bags, routines, and
          parachutes, and so are the custom card, sessions up to 12 hours,
          and silence during sessions. The app is still in
          development: there is no download yet, and one will appear here
          only when it is real.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ WHY THE NAME ============ -->
  <section class="section alt" id="name">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Why the name</span>
        <h2>Kaizen, daily.</h2>
        <p>
          Kaizenly is Kaizen, daily — the Japanese idea that small,
          continuous improvement compounds into something real. Three words,
          one habit.
        </p>
      </div>
      <div class="feature-grid">
        {
          nameParts.map((p, i) => (
            <article class="feature-card reveal" style={`--d: ${(i % 3) * 0.08}s`}>
              <div class="icon">●</div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PHILOSOPHY ============ -->
  <section class="section" id="philosophy">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">The philosophy</span>
        <h2>Strict about the session, gentle about the person.</h2>
        <p>
          Kaizenly does not believe in pressure, perfectionism, or
          guilt-driven productivity. It believes in gentle progress, personal
          space, and realistic systems — calm focus instead of chaotic
          hustle. The session is strict; the person is not punished for
          being human.
        </p>
      </div>
      <div class="feature-grid">
        {
          philosophy.map((p, i) => (
            <article class="feature-card reveal" style={`--d: ${(i % 3) * 0.08}s`}>
              <div class="icon">●</div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ THE DEVELOPER ============ -->
  <section class="section alt" id="developer">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Built by Nadeem</span>
        <h2>A solo developer, building for himself first.</h2>
        <p>
          Kaizenly is built by <strong>Nadeem Mazhar</strong>, a solo
          developer — <strong>Nadeem Dev Apps</strong>. He plans, directs,
          and reviews; AI tools do the heavy lifting. Every app starts as
          his own problem: Kaizenly began with a phone that would not stay
          down, Tsumly with a ledger that never added up.
        </p>
        <p style="margin-top: 16px;">
          Questions, feedback, or just want to say hi? Reach him at
          <a href="mailto:nadeem.devapps@gmail.com">nadeem.devapps@gmail.com</a>,
          or find his work on GitHub at
          <a href="https://github.com/nadeemdevapps">github.com/nadeemdevapps</a>
          — his only social link.
        </p>
      </div>
      <p class="reveal" style="text-align: center;">
        <a class="about-link" href={siteHome}>More from Nadeem Dev Apps →</a>
      </p>
    </div>
  </section>

  <script>
    (function () {
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var revealEls = document.querySelectorAll('.reveal');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealEls.forEach(function (el) { el.classList.add('in'); });
      } else {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        revealEls.forEach(function (el) { io.observe(el); });
      }
    })();
  </script>
</KaizenLayout>
