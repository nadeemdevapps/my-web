---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteHome = 'https://nadeemdevapps.github.io/my-web/';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-lockup" href={base} aria-label="Tsumly — home">
        <img src={`${base}logo.svg`} alt="" width="34" height="34" />
        <span>Tsumly</span>
      </a>
      <p class="footer-tagline">Every amount adds up.</p>
      <p class="footer-built">
        Built by <a href={siteHome}>Nadeem</a> — solo developer, Nadeem Dev Apps.
      </p>
    </div>

    <nav class="footer-col" aria-label="Tsumly">
      <h2>Tsumly</h2>
      <ul>
        <li><a href={base}>Overview</a></li>
        <li><a href={`${base}privacy/`}>Privacy Policy</a></li>
        <li><a href={`${base}terms/`}>Terms of Use</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Machine-readable">
      <h2>Machine</h2>
      <ul>
        <li><a href={`${base}llms.txt`}>llms.txt</a></li>
        <li><a href={`${base}robots.txt`}>robots.txt</a></li>
        <li><a href={`${base}sitemap.xml`}>sitemap.xml</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>© 2026 Nadeem Dev Apps — Built with Astro.</p>
    <p>Your money stays yours.</p>
  </div>
</footer>
