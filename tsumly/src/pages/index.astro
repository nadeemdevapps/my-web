---
import TsumlyLayout from '../layouts/TsumlyLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const releasesUrl = 'https://github.com/nadeemdevapps/tsumly/releases';

const faqs = [
  {
    q: 'Is my money data stored on a server?',
    a: 'No. Tsumly is local-first: your accounts, transactions, loans and settings live in a local database on your device. There is no Tsumly account and no sign-up, no analytics, no ads, and nothing phoning home. The only thing that ever leaves the phone is a backup you choose to make — an encrypted Google Drive backup to your own private Drive folder, or a .moneybackup file you export yourself.',
  },
  {
    q: 'Can I record loans from before I started using the app?',
    a: 'Yes — pre-app loans record older loans without moving your current balance, so your history is complete and your balance stays honest. You can flip a loan’s pre-app mark later; the amount, due date and repayments stay unchanged.',
  },
  {
    q: 'What if someone pays back more than the loans add up to?',
    a: 'That cannot happen by mistake: a repayment cannot be more than the selected loans’ total outstanding. The split pays the smallest outstanding loan first, and the oldest first when two are equal — and a repayment recorded by mistake can be reversed in one step.',
  },
  {
    q: 'Does Tsumly work offline?',
    a: 'Yes. Everything is stored on your device and the app works offline. The only features that need the internet are the optional Google Drive backup and restore.',
  },
  {
    q: 'Can I export my records?',
    a: 'Yes. Monthly reports show cash in, cash out and net by category, and statements turn any slice of the ledger into a PDF you can share: all activity, expense, income, loans, transfers and per-account statements, plus per-person statements for any date range you pick. You can also export everything to a timestamped .moneybackup file and restore it on any device.',
  },
  {
    q: 'What does Tsumly cost?',
    a: 'Nothing. Tsumly is free — no account, no subscription, no ads. Your money stays on your device.',
  },
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Tsumly',
  applicationCategory: 'FinanceApplication',
  applicationSubCategory: 'Personal Finance',
  operatingSystem: 'Android',
  url: `https://nadeemdevapps.github.io${base}products/tsumly/`,
  description:
    'Tsumly is a local-first personal expense and loan ledger for Android — track income, expenses, transfers and who owes whom, split multi-loan repayments, and keep every amount accounted for.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: { '@type': 'Organization', name: 'Nadeem Dev Apps' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<TsumlyLayout
  title="Tsumly — Local-First Loan & Ledger App"
  description="Tsumly is a local-first personal expense and loan ledger for Android — track income, expenses, transfers and who owes whom, split multi-loan repayments, and keep every amount accounted for."
  jsonLd={[softwareLd, faqLd]}
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container narrow">
      <div class="reveal">
        <img class="mark" src={`${base}logo.svg`} alt="Tsumu, the Tsumly coin-stack mascot" width="96" height="96" />
        <h1><span class="dim">Every amount</span> adds up.</h1>
        <p class="hero-lede">
          Tsumly is a <strong>local-first</strong> personal expense and loan
          ledger for Android: your money stays on your device — <strong>no
          account, no cloud by default</strong> — with an optional encrypted
          Google Drive backup. It tracks <strong>income, expenses and
          transfers</strong> between accounts, and its <strong>smart
          multi-loan repayment split</strong> spreads one repayment across
          several loans, while <strong>pre-app loans</strong> record older
          loans without moving your balance.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={releasesUrl}>Get Tsumly on GitHub</a>
          <a class="btn btn-secondary" href="#how-it-works">See how it works</a>
        </div>
        <p class="hero-note">Free. Android. No account needed.</p>
      </div>
    </div>
  </section>

  <!-- ============ WHY TSUMLY ============ -->
  <section class="section alt" id="name">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">The name</span>
        <h2>Why Tsumly?</h2>
        <p>
          The name is inspired by the Japanese verb <strong>tsumu</strong> (積む)
          — to stack, to accumulate, to build up over time.
        </p>
      </div>
      <div class="name-grid">
        <article class="card name-card reveal" style="--d: 0s">
          <h3>Stack</h3>
          <p>
            <strong>Tsumu means to stack.</strong> Every amount stacks onto the
            last — a loan, a repayment, a rupee at a time — until the ledger is
            complete.
          </p>
        </article>
        <article class="card name-card reveal" style="--d: 0.1s">
          <h3>Accumulate</h3>
          <p>
            Small amounts, recorded honestly, <strong>accumulate into the full
            picture</strong>: what you are owed, and what you owe.
          </p>
        </article>
        <article class="card name-card reveal" style="--d: 0.2s">
          <h3>Build up</h3>
          <p>
            Over weeks and months the ledger <strong>builds up into a record you
            can trust</strong> — and a history you can share.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section" id="how-it-works">
    <div class="container narrow">
      <div class="reveal">
        <span class="kicker">How it works</span>
        <h2>A ledger that lives on your phone.</h2>
        <p class="lede">
          Tsumly is a <strong>local-first ledger</strong> for the money you
          <strong>lend and borrow</strong>. Record a loan, note who it is
          with, and keep a <strong>running balance</strong> — everything is
          stored on your device, and it works offline.
        </p>
        <ul class="feature-list">
          <li><strong>Lend or borrow</strong> — record a loan in either direction, with its due amount, fees, and history.</li>
          <li><strong>Partial repayments</strong> — a loan can be paid back a little at a time, and every payment is recorded against the same loan.</li>
          <li><strong>Running balance</strong> — always see where you stand: what you are owed, and what you owe.</li>
          <li><strong>Settle in full</strong> — pay off a loan's full remaining balance in one step, after a confirmation.</li>
          <li><strong>Edits stay honest</strong> — a loan's note and due date can be edited, and a loan with no repayments can be deleted; the money itself only moves through repayments.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ SMART REPAYMENT SPLIT ============ -->
  <section class="section alt">
    <div class="container narrow">
      <div class="reveal">
        <span class="kicker">Smart repayment split</span>
        <h2>One repayment, split across every loan it covers.</h2>
        <p class="lede">
          When someone pays you back, the money rarely matches a single loan.
          Tsumly <strong>splits one repayment across several active
          loans</strong> in a single action — and <strong>never merges
          loans</strong>, so each loan keeps its own history.
        </p>
        <ul class="feature-list">
          <li><strong>Pre-selected for you</strong> — Tsumly picks the loans the repayment applies to, and shows which will be <strong>fully paid</strong> and which <strong>partially</strong>.</li>
          <li><strong>No merging</strong> — a Rs. 3,000 loan repaid by Rs. 1,170 stays one loan with <strong>Rs. 1,830 left</strong>.</li>
          <li><strong>Mistakes are reversible</strong> — a repayment recorded by mistake can be <strong>reversed in one step</strong>.</li>
          <li><strong>Smallest first</strong> — the split pays the smallest outstanding loan first, and the oldest loan first when two are equal.</li>
          <li><strong>Overpayment is blocked</strong> — a repayment cannot be more than the selected loans' total outstanding.</li>
          <li><strong>Auto-select, on by default</strong> — Tsumly pre-selects all of a person's open loans; turn it off in settings to pick by hand.</li>
          <li><strong>Every split is recorded</strong> — each repayment stores how much landed on each loan, and the balance before and after, so statements can show the breakdown.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ PRE-APP LOANS ============ -->
  <section class="section">
    <div class="container narrow">
      <div class="reveal">
        <span class="kicker">Pre-app loans</span>
        <h2>Loans from before the app still count.</h2>
        <p class="lede">
          You were lending and borrowing long before Tsumly. <strong>Pre-app
          loans</strong> record those older loans <strong>without moving your
          current balance</strong> — so your history is complete and your
          balance stays honest.
        </p>
        <ul class="feature-list">
          <li><strong>Mark it pre-app</strong> — when you create a loan that started before the app, it is recorded without an opening balance movement.</li>
          <li><strong>Same detail, same history</strong> — every loan keeps its own due amount, fees, and history, pre-app or not.</li>
          <li><strong>Flip it later</strong> — marking a loan pre-app adds its opening movement back to the account; removing the mark records it. The amount, due date and repayments stay unchanged.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ PERSON PROFILES ============ -->
  <section class="section alt">
    <div class="container narrow">
      <div class="reveal">
        <span class="kicker">Person profiles</span>
        <h2>People, not just numbers.</h2>
        <p class="lede">
          Loans live on <strong>person profiles</strong>, so you always see
          <strong>who owes what</strong>. Each person carries their own
          totals, and nothing about an open loan can be hidden by accident.
        </p>
        <ul class="feature-list">
          <li><strong>Per-person totals</strong> — every profile shows what that person owes you, and what you owe them.</li>
          <li><strong>Archive is guarded</strong> — a person with <strong>outstanding loans cannot be archived</strong>.</li>
          <li><strong>Archived people stay reachable</strong> — they still appear in the person picker, and picking one <strong>restores them automatically</strong>.</li>
          <li><strong>Delete is refused while loans exist</strong> — a person with any loan cannot be deleted; archive them instead.</li>
          <li><strong>A full ledger per person</strong> — loans opened and repayments made in one interleaved history, with open and paid loan counts.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ EVERYDAY MONEY ============ -->
  <section class="section">
    <div class="container narrow">
      <div class="reveal">
        <span class="kicker">Everyday money</span>
        <h2>Income, expenses and transfers — in the same ledger.</h2>
        <p class="lede">
          Tsumly tracks the everyday money too — <strong>income and
          expenses</strong> against categories and accounts, and
          <strong>transfers between your own accounts</strong> — so the loan
          ledger and the cash ledger always agree.
        </p>
        <ul class="feature-list">
          <li><strong>Income &amp; expenses</strong> — record money in and money out against an account and a category, with an optional note, fee and tax on every entry.</li>
          <li><strong>Transfers between accounts</strong> — move money from one account to another in one entry, with its own fee and tax; deleting a transfer removes both legs and puts the balances back.</li>
          <li><strong>Fees &amp; taxes, kept visible</strong> — every income, expense, transfer, loan and repayment can carry a fee and a tax, and monthly reports total them separately.</li>
          <li><strong>Categories with subcategories</strong> — starter categories for Pakistani households, including Salary, Business, Freelance, Groceries and Transport, with subcategories such as Supermarket and Local Market; add, rename or archive your own, two levels deep.</li>
          <li><strong>Dates you control</strong> — entries carry the date and time you choose, and an entry keeps the clock time you recorded even when you travel across timezones.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ ACCOUNTS ============ -->
  <section class="section alt">
    <div class="container narrow">
      <div class="reveal">
        <span class="kicker">Accounts</span>
        <h2>Every rupee lives in an account.</h2>
        <p class="lede">
          Cash, a bank, JazzCash, Easypaisa or another wallet — each account
          has its own <strong>opening balance</strong> and a live balance that
          follows every movement.
        </p>
        <ul class="feature-list">
          <li><strong>Opening balance per account</strong> — start each account with the money already in it; its balance is the opening balance plus every movement since.</li>
          <li><strong>Five account types</strong> — Cash, Bank, JazzCash, Easypaisa and Other, each with its own icon.</li>
          <li><strong>Archive, never delete</strong> — archiving an account keeps its history intact, and archived accounts are excluded from your available balance.</li>
          <li><strong>Balance guard</strong> — when a payment would take an account below zero, Tsumly either warns you and waits for confirmation, or blocks it — your choice in settings.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ REPORTS & STATEMENTS ============ -->
  <section class="section">
    <div class="container narrow">
      <div class="reveal">
        <span class="kicker">Reports &amp; statements</span>
        <h2>Where the money went, on one screen — and on paper.</h2>
        <p class="lede">
          Monthly reports show <strong>where the money went</strong>, and
          statements turn any slice of the ledger into a
          <strong>PDF you can share</strong>.
        </p>
        <ul class="feature-list">
          <li><strong>Monthly reports</strong> — cash in, cash out and net for any month, with income and expense broken down by category, a weekly cash-flow chart, fees and taxes totalled, and lent and borrowed positions.</li>
          <li><strong>Six statement exports</strong> — all activity, expense, income, loans, transfers and per-account statements, each as a PDF.</li>
          <li><strong>Per-person statements</strong> — from any person's profile, export their loans and repayments as a PDF for a date range you pick: last 30 or 90 days, last 6 months, last year, all time, or a custom range.</li>
          <li><strong>Repayment breakdowns on statements</strong> — every repayment shows how it was split across loans, because each split is stored with the repayment.</li>
          <li><strong>Share or save</strong> — every statement PDF can be shared from the system share sheet or saved as a file.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ HOME DASHBOARD ============ -->
  <section class="section alt">
    <div class="container narrow">
      <div class="reveal">
        <span class="kicker">Home dashboard</span>
        <h2>Your money, the moment you open the app.</h2>
        <p class="lede">
          The home tab opens on your <strong>available balance</strong>, your
          <strong>net position</strong>, and what you have <strong>lent and
          borrowed</strong> — with one-tap actions for income, expense,
          transfer or a loan payment.
        </p>
        <ul class="feature-list">
          <li><strong>Available balance &amp; net position</strong> — the balance across your active accounts, with the net position underneath it; either can be hidden in settings.</li>
          <li><strong>Lent &amp; borrowed at a glance</strong> — two tiles show what others owe you and what you owe, always live.</li>
          <li><strong>Quick actions</strong> — Income, Expense, Transfer and Loan from one row; the Loan action opens the smart repayment flow for a person.</li>
          <li><strong>Daily quote</strong> — a short quote under the greeting, drawn from a bundled set, with Urdu quotes shown right-to-left in a Nastaliq or Naskh font you pick.</li>
          <li><strong>Pull to refresh</strong> — a pull refreshes every number on the dashboard.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ LOAN REMINDERS ============ -->
  <section class="section">
    <div class="container narrow">
      <div class="reveal">
        <span class="kicker">Loan reminders</span>
        <h2>A due date that reminds you itself.</h2>
        <p class="lede">
          A loan with a due date reminds you on its own: a local notification
          on the <strong>due date at 9:00 AM</strong>, and an
          <strong>overdue reminder the next morning</strong> if it is still
          open.
        </p>
        <ul class="feature-list">
          <li><strong>Due-date reminders</strong> — set an optional due date when you create a loan; Tsumly schedules a 9:00 AM reminder for the day and an overdue reminder the next day.</li>
          <li><strong>Tapping opens the loan</strong> — a reminder opens the loan's detail screen, ready to record the repayment.</li>
          <li><strong>Reminders follow the loan</strong> — editing a due date reschedules its reminders, and deleting a loan cancels them.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ MAKE IT YOURS ============ -->
  <section class="section alt">
    <div class="container narrow">
      <div class="reveal">
        <span class="kicker">Make it yours</span>
        <h2>Light or dark, your font, your currency.</h2>
        <p class="lede">
          Tsumly bends to how you like it: <strong>light or dark</strong>,
          your <strong>display font</strong>, and which numbers the home tab
          shows.
        </p>
        <ul class="feature-list">
          <li><strong>Theme &amp; display font</strong> — System, Dark or Light theme, and Bricolage Grotesque or EB Garamond for headings.</li>
          <li><strong>Show or hide</strong> — available balance, net position and animated amounts can each be switched off.</li>
          <li><strong>One base currency</strong> — pick from 15 currencies on first run, PKR pre-selected; everything is recorded in that one currency.</li>
          <li><strong>Your name on the greeting</strong> — the home greeting uses the display name you set in settings.</li>
          <li><strong>Date &amp; time control</strong> — allow changing the date and time on entries, or lock them to now.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ BACKUP & PRIVACY ============ -->
  <section class="section">
    <div class="container narrow">
      <div class="reveal">
        <span class="kicker">Backup &amp; privacy</span>
        <h2>Your money stays yours.</h2>
        <p class="lede">
          <strong>Offline-first and one-device-first.</strong> Nothing leaves
          the phone unless you turn on Drive backup — and even then, the
          backup is <strong>encrypted</strong> and stored in the app's
          <strong>own private Drive folder</strong>.
        </p>
        <ul class="feature-list">
          <li><strong>No account, no cloud by default</strong> — your money stays on your device; there is nothing to sign up for.</li>
          <li><strong>Encrypted backup</strong> — the optional Google Drive backup is encrypted with <strong>AES-256-GCM</strong>.</li>
          <li><strong>No tracking</strong> — no analytics, no ads, nothing phoning home.</li>
          <li><strong>Sign-in stays on the device</strong> — device-specific sign-in details never leave the phone in a portable backup.</li>
          <li><strong>Local backup file</strong> — export everything to a timestamped <strong>.moneybackup</strong> file and restore it on any device; older backups are migrated on import.</li>
          <li><strong>Scheduled Drive backups</strong> — hourly, daily, weekly or monthly automatic uploads to your private Drive folder, keeping the latest three.</li>
          <li><strong>Password protection</strong> — an optional password of at least 8 characters encrypts a backup (AES-256-GCM, PBKDF2 with 600,000 iterations); scheduled uploads can reuse a password kept in the Android Keystore.</li>
          <li><strong>Restore on first run</strong> — a fresh install offers to restore from a local backup file or from Drive before you set anything up.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section alt" id="faq">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">FAQ</span>
        <h2>Questions, answered.</h2>
      </div>
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details class="faq-item reveal">
              <summary>{f.q}</summary>
              <div class="faq-body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    // Restrained reveals: elements fade up once as they enter view.
    var els = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      els.forEach(function (el) {
        io.observe(el);
      });
    } else {
      els.forEach(function (el) {
        el.classList.add('in');
      });
    }
  </script>
</TsumlyLayout>
