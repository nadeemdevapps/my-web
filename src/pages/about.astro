---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteUrl = `https://nadeemdevapps.github.io${base}`;
const faqs = [
  {
    question: 'Who is Nadeem Mazhar?',
    answer:
      "Nadeem Mazhar is a solo developer in Pakistan who runs Nadeem Dev Apps, a one-developer studio with no partners and no team. He plans, designs, and ships websites, Windows apps, Android apps, and backends, and his apps Tsumly and Kaizenly started as his own problems.",
  },
  {
    question: 'What does Nadeem build?',
    answer:
      "Nadeem builds websites, Windows apps, Android apps, and backends — local-first or cloud, whichever the project needs. His shipped apps are local-first by design, with no account, no server, and no ads, because that is the right call for a personal tool, not a limitation on what he can build.",
  },
  {
    question: 'How does Nadeem work with AI?',
    answer:
      "Nadeem plans the product, designs the interface, directs the build, and reviews everything before it ships, with AI tools doing the heavy lifting under his direction. The decisions are his: he explores a problem until he understands it, documents a clear plan, and ships only when the result works in daily use.",
  },
  {
    question: "What are Nadeem's strengths?",
    answer:
      "His strengths are exploration, working with AI, UI design, planning, brainstorming, and problem-solving, with security analysis on every build. He is still learning some languages and knows the basics of others, but the job, as he puts it, was never typing syntax by hand.",
  },
  {
    question: "Are Nadeem's apps free to use?",
    answer:
      "Yes. Everything Nadeem makes is free to use right now. Kaizenly's premium durations — custom sessions of 3 to 12 hours — arrive with Play Billing, so there is nothing to pay for today.",
  },
  {
    question: 'What are Tsumly, Kaizenly, and MsgLoop?',
    answer:
      "Tsumly is a local-first loan and ledger app that splits one repayment across several loans without merging them. Kaizenly is a strict focus guard for Android whose timed sessions keep distracting apps shut until the timer ends. MsgLoop is a WhatsApp message scheduler for Android — and because it automates WhatsApp, which WhatsApp's terms do not allow, bulk messaging can get a number banned.",
  },
  {
    question: 'How can I contact Nadeem?',
    answer:
      'You can reach Nadeem at nadeem.devapps@gmail.com, or find his work on GitHub at github.com/nadeemdevapps, his only social link. The contact page also has a form that opens a pre-addressed email in your own mail app.',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}#nadeem`,
    name: 'Nadeem Mazhar',
    jobTitle: 'Solo Developer',
    description:
      'Solo developer in Pakistan. Builds websites, Windows apps, Android apps, and backends — local-first or cloud, whichever the project needs — with AI doing the heavy lifting under his direction.',
    url: `${siteUrl}about/`,
    sameAs: ['https://github.com/nadeemdevapps'],
  },
  faqJsonLd,
];
---

<BaseLayout
  title="About Nadeem Mazhar — Solo Developer"
  description="About Nadeem Mazhar — a solo developer in Pakistan building websites, Windows apps, Android apps, and backends with AI doing the heavy lifting."
  jsonLd={jsonLd}
>
  <section>
    <div class="container narrow">
      <span class="kicker">About</span>
      <h1>I'm Nadeem Mazhar.</h1>
      <p class="lede">
        Nadeem Dev Apps is my <strong>one-developer studio</strong>. I'm a
        <strong>solo developer in Pakistan</strong> — no partner, no team —
        I plan, design, and ship <strong>websites, Windows apps, Android apps, and
        backends</strong>, with AI tools doing the heavy lifting under my
        direction. Tsumly and Kaizenly started as my own problems, and they ship
        only when they work in daily use.
      </p>
      <p style="margin-top: 24px;">
        <a class="btn btn-primary" href={`${base}products/`}>See my work</a>
      </p>
    </div>
  </section>

  <section class="section-alt">
    <div class="container narrow">
      <span class="kicker">The founder</span>
      <h2>A solo developer, building for himself first.</h2>
      <p class="lede">
        I'm a <strong>solo developer based in Pakistan</strong> — no partners,
        no team. I work the way a one-person studio should: I
        <strong>plan</strong> the product, <strong>design</strong> the
        interface, <strong>direct</strong> the build, and
        <strong>review</strong> everything before it ships. AI tools do the
        heavy lifting; the decisions are mine.
      </p>
      <p class="lede">
        I'm still learning some languages, and I know the basics of others —
        but the job was never typing syntax by hand. The job is
        <strong>exploration, working with AI, UI design, planning,
        brainstorming, problem-solving, and security analysis</strong> — and that's where I'm
        strong. I ship real products by combining my judgment with the best
        tools available.
      </p>
      <p class="lede">
        The apps on this site are <strong>local-first by design</strong> — no
        account, no server, no ads — because that's the right call for a
        personal tool. It's a choice, not a limitation: I also build
        <strong>websites, Windows apps, Android apps, backends, and
        cloud-based apps</strong> — whichever the project needs.
      </p>
      <p class="lede">
        Everything I make is <strong>free to use right now</strong> — Kaizenly's premium durations arrive with Play Billing.
      </p>
    </div>
  </section>

  <section>
    <div class="container narrow">
      <span class="kicker">What we stand for</span>
      <h2>One problem, solved well.</h2>
      <ul class="feature-list">
        <li><strong>One problem, solved well</strong> — each app does a single job properly instead of ten things halfway. If it needs a second job, it becomes a second app.</li>
        <li><strong>Private by default</strong> — no accounts, no tracking, no ads. Your data stays on your device; backups go to your own storage, when you choose.</li>
        <li><strong>Calm, not pushy</strong> — that's how I work and communicate: no pressure, no perfectionism, no guilt-driven productivity. I build steadily and let the work speak for itself.</li>
      </ul>
    </div>
  </section>

  <section class="section-alt">
    <div class="container narrow">
      <span class="kicker">How we build</span>
      <h2>Ship only what works.</h2>
      <ul class="feature-list">
        <li><strong>Built for myself first</strong> — every app starts as my own problem. Tsumly and Kaizenly earned their place by working in daily use.</li>
        <li><strong>Shipped when it works</strong> — features land after real daily use, not after a roadmap date. What you see in Tsumly and Kaizenly is what is actually running on the developer's own phone.</li>
        <li><strong>Honest copy</strong> — no fake badges, ratings, or reviews. A download button, a Play Store badge, or a rating appears only when it is real.</li>
      </ul>
    </div>
  </section>

  <section class="section-alt">
    <div class="container narrow">
      <span class="kicker">Questions</span>
      <h2>Questions, answered.</h2>
      {faqs.map((faq) => (
        <>
          <h3>{faq.question}</h3>
          <p>{faq.answer}</p>
        </>
      ))}
      <p>
        Learn more about <a href={`${base}products/tsumly/`}>Tsumly</a>, <a href={`${base}products/kaizenly/`}>Kaizenly</a>, and <a href={`${base}products/msgloop/`}>MsgLoop</a> — or <a href={`${base}contact/`}>get in touch</a>.
      </p>
    </div>
  </section>

  <section>
    <div class="container narrow">
      <span class="kicker">Contact</span>
      <h2>Say hello.</h2>
      <p class="lede">
        Questions, feedback, or just want to say hi? Reach me at
        <a href="mailto:nadeem.devapps@gmail.com">nadeem.devapps@gmail.com</a>.
      </p>
      <p style="margin-top: 24px;">
        <a class="btn btn-primary" href={`${base}contact/`}>Get in touch</a>
        <a class="btn btn-secondary" href="https://github.com/nadeemdevapps">github.com/nadeemdevapps</a>
      </p>
    </div>
  </section>
</BaseLayout>
