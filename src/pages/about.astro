---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="About"
  description="About Nadeem Dev Apps — a one-developer studio building small, local-first apps."
>
  <section>
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>Built by one developer, for himself first.</h1>
      <p style="max-width: 640px;">
        Nadeem Dev Apps is a one-developer studio. Every app here started as
        a personal problem — a ledger that never added up, a phone that never
        stayed quiet — and each one ships only when it works in daily use.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <span class="eyebrow">How we build</span>
      <h2>Local-first. Private by design.</h2>
      <div class="product-grid">
        <article class="card">
          <h3>Your data stays yours</h3>
          <p>Apps work fully on your device. No accounts, no tracking, no ads — backups go to your own storage, when you choose.</p>
        </article>
        <article class="card">
          <h3>One problem, done well</h3>
          <p>Each app solves a single problem properly instead of doing ten things halfway. If it needs a second job, it becomes a second app.</p>
        </article>
        <article class="card">
          <h3>Ships when it works</h3>
          <p>Features land after real daily use, not after a roadmap date. What you see is what is actually running on the developer's own phone.</p>
        </article>
      </div>
      <p style="margin-top: 24px;">
        <a class="btn btn-primary" href={`${base}products/`}>See the products</a>
      </p>
    </div>
  </section>
</BaseLayout>
