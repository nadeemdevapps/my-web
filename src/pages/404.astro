---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist — it may have moved, or the link is wrong."
>
  <section class="not-found">
    <div class="container">
      <h1 class="not-found-code">404</h1>
      <p class="not-found-headline">This page wandered off.</p>
      <p class="muted">
        It may have moved, or the link is wrong. The apps are still here —
        start from home, or browse the products.
      </p>
      <div class="not-found-cta">
        <a class="btn btn-primary" href={`${base}`}>Back home</a>
        <a class="btn btn-secondary" href={`${base}products/`}>All products</a>
      </div>
    </div>
  </section>
</BaseLayout>
