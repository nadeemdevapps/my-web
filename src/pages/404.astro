---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist — it may have moved, or the link is wrong."
>
  <section class="hero-band">
    <div class="stickers" aria-hidden="true">
      <i style="top: 18%; right: 12%; background: var(--sticker-pink);"></i>
      <i style="top: 62%; right: 22%; background: var(--sticker-teal);"></i>
      <i style="top: 30%; right: 30%; background: var(--sticker-orange);"></i>
      <i style="top: 72%; right: 8%; background: var(--sticker-purple);"></i>
      <i style="top: 14%; right: 38%; background: var(--sticker-green);"></i>
    </div>
    <div class="container">
      <span class="eyebrow">404 · Page not found</span>
      <h1>This page<br />wandered off.</h1>
      <p>
        It may have moved, or the link is wrong. The apps are still here —
        start from home, or browse the products.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`${base}`}>Back home</a>
        <a class="btn-secondary--on-dark btn" href={`${base}products/`}>All products</a>
      </div>
    </div>
  </section>
</BaseLayout>
