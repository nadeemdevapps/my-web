---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist — it may have moved, or the link is wrong."
>
  <section class="hero">
    <div class="container">
      <Logo size={48} />
      <h1>This page<br /><span class="accent">wandered off.</span></h1>
      <p class="muted">
        It may have moved, or the link is wrong. The apps are still here —
        start from home, or browse the products.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`${base}`}>Back home</a>
        <a class="btn btn-secondary" href={`${base}products/`}>All products</a>
      </div>
    </div>
  </section>
</BaseLayout>
