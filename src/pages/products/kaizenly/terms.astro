---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import LegalDoc from '../../../components/LegalDoc.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<ProductLayout
  title="Kaizenly Terms of Use"
  description="Terms of use for Kaizenly, the strict local-first focus guard — timed sessions, parachutes, and local-only data, provided as-is."
  productName="Kaizenly"
  productBase={`${base}products/kaizenly/`}
>
  <LegalDoc
    title="Kaizenly Terms of Use"
    intro="Kaizenly is a strict focus guard, provided as-is. Its strictness is the point."
    sections={[
      {
        heading: 'Acceptance',
        body: 'By installing and using Kaizenly, you agree to these terms. If you do not agree with any part of them, please do not use the app.',
      },
      {
        heading: 'What Kaizenly does',
        body: 'Kaizenly blocks distracting apps behind a timed focus session. You pick a duration and a bag \u2014 a named set of apps \u2014 and every app in the active bag is blocked until the session ends. Sessions are designed to be hard to break: leaving early costs a parachute, and a 30-minute break is available during longer sessions.',
      },
      {
        heading: 'Local-first, no Kaizenly account',
        body: 'Kaizenly stores your sessions in a local database on your device, and bags, routines, and settings in on-device preferences. There is no Kaizenly account and no sign-up, and Kaizenly operates no server that receives your data. On Android the app opts out of automatic cloud backup (allowBackup=false), so a fresh install starts empty and uninstalling the app wipes its local data.',
      },
      {
        heading: 'Permissions',
        body: 'Blocking needs sensitive permissions: usage access, the accessibility service, device admin, and the overlay permission. You grant each of them yourself, and you can revoke them at any time in your phone\u2019s settings. Revoking them may stop blocking from working, including sessions already in progress.',
      },
      {
        heading: 'Premium',
        body: 'Some features, such as custom session durations, are premium and will be sold through Google Play Billing when they go live. Purchases and refunds will follow Google Play\u2019s terms.',
      },
      {
        heading: 'Acceptable use',
        body: 'Use Kaizenly for lawful personal focus tracking only. You may not use the app to record, conceal, or facilitate anything illegal.',
      },
      {
        heading: 'Provided as-is',
        body: 'Kaizenly is provided "as is" and "as available", without warranties of any kind, express or implied, including any implied warranty of fitness for a particular purpose. To the extent permitted by law, the developer is not liable for any loss or damage arising from your use of the app, including a missed block or a lost streak.',
      },
      {
        heading: 'Stopping use',
        body: 'You can stop using Kaizenly at any time. Uninstalling the app deletes its local data from the device. If device admin is enabled, turn it off in the app first, or remove it from your phone\u2019s device admin settings before uninstalling.',
      },
      {
        heading: 'Changes to these terms',
        body: 'These terms may be updated from time to time. The version on this page is always the current one.',
      },
      {
        heading: 'Contact',
        body: 'Questions about these terms? Email nadeem.devapps@gmail.com.',
      },
    ]}
  />
</ProductLayout>
