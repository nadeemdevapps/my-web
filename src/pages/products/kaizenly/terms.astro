---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import ComingSoon from '../../../components/ComingSoon.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<ProductLayout
  title="Kaizenly Terms of Use"
  description="Terms of use for the Kaizenly app."
  productName="Kaizenly"
  productBase={`${base}products/kaizenly/`}
>
  <ComingSoon
    title="Kaizenly Terms of Use"
    text="Kaizenly's terms of use are coming soon."
  />
</ProductLayout>
