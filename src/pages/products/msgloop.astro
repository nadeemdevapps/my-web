---
import ProductLayout from '../../layouts/ProductLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'MsgLoop',
    applicationCategory: 'UtilitiesApplication',
    applicationSubCategory: 'Message Scheduling',
    operatingSystem: 'Android',
    url: `https://nadeemdevapps.github.io${base}products/msgloop/`,
    description: 'MsgLoop is a local-first WhatsApp message scheduler for Android — repeat messages on a schedule from your phone. Automating WhatsApp carries a ban risk.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    author: { '@type': 'Organization', name: 'Nadeem Dev Apps' },
  },
];
---

<ProductLayout
  title="MsgLoop — WhatsApp Message Scheduler"
  description="MsgLoop is a local-first WhatsApp message scheduler for Android — repeat messages on a schedule from your phone. Automating WhatsApp carries a ban risk."
  productName="MsgLoop"
  productBase={`${base}products/msgloop/`}
  jsonLd={jsonLd}
  developerSection
>
  <section>
    <div class="container narrow">
      <h1>Send the same message, on repeat — on schedule.</h1>
      <p class="lede">
        MsgLoop is a <strong>local-first WhatsApp message scheduler</strong>
        for Android. Log in once inside the app, then send one message many
        times — right now, or at a time you pick. Everything runs on your
        phone: <strong>no account, no server, no tracking</strong>, and no
        data leaves the device except through WhatsApp itself.
      </p>
    </div>
  </section>

  <section class="section-alt">
    <div class="container narrow">
      <span class="kicker">Important</span>
      <h2>A warning before you use it</h2>
      <p class="lede">
        MsgLoop automates WhatsApp Web, which WhatsApp's Terms of Service do
        not allow — bulk messaging can get a number temporarily or permanently
        banned. Use it only on numbers you own or have permission to message.
        Keep the delay conservative for large counts, and prefer smaller
        batches.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <span class="kicker">Features</span>
      <h2>What MsgLoop does</h2>
      <div class="product-grid">
        <article class="card">
          <h3>Schedule for later</h3>
          <p>Pick a date and time; an exact alarm wakes a background service and the messages go out when you said they would.</p>
        </article>
        <article class="card">
          <h3>Send now, on repeat</h3>
          <p>One message, sent N times with a delay you choose (0.3s to 5s, or your own value) — with a live preview of the chat as it sends.</p>
        </article>
        <article class="card">
          <h3>A queue that survives anything</h3>
          <p>Tasks are stored on the phone, so they survive the app being closed, the phone restarting, and alarms being cleared. Missed tasks fire when the app opens again.</p>
        </article>
        <article class="card">
          <h3>Live progress and history</h3>
          <p>Watch sent, failed, and remaining counts with a live time estimate, stop a task any time, and see every finished task's result afterwards.</p>
        </article>
        <article class="card">
          <h3>Private by design</h3>
          <p>No account, no analytics, no tracking. Your login and your tasks stay on your phone; Android backup is off.</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container narrow">
      <p class="muted">Privacy and Terms are already live on this site — see the links above.</p>
    </div>
  </section>
</ProductLayout>
