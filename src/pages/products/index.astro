---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  title="Selected Works by Nadeem Mazhar"
  description="Selected works by Nadeem Mazhar — 10 projects: 6 shipped products (Tsumly, Kaizenly, MsgLoop, CV Creator Pro, Nydrex Suite, Brew & Bean Cafe) and 4 demo concepts, plus 5 concept demos."
>
  <section class="page-top">
    <div class="wrap">
      <div class="sec-head">
        <h1 class="display">Selected work</h1>
        <p class="count">10 projects — 6 shipped products, 4 demo concepts</p>
      </div>

      <div class="filter-row" role="group" aria-label="Filter projects by category">
        <button class="filter-btn is-active" type="button" data-filter="all" aria-pressed="true"><span>All projects</span><span class="filter-badge">10</span></button>
        <button class="filter-btn" type="button" data-filter="mobile" aria-pressed="false"><span>Mobile &amp; Native</span><span class="filter-badge">3</span></button>
        <button class="filter-btn" type="button" data-filter="web" aria-pressed="false"><span>Web</span><span class="filter-badge">2</span></button>
        <button class="filter-btn" type="button" data-filter="desktop" aria-pressed="false"><span>Desktop</span><span class="filter-badge">1</span></button>
        <button class="filter-btn" type="button" data-filter="tools" aria-pressed="false"><span>Developer Tools</span><span class="filter-badge">4</span></button>
      </div>

      <div class="works-grid" id="works-grid">
        <article class="project-card tsumly" data-category="mobile" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Ts</span></div>
          <div class="body">
            <h3>Tsumly</h3>
            <span class="tag">Android · Finance</span>
            <p>A local-first expense tracker with a smart multi-loan repayment split — the finance app I needed, built for myself.</p>
            <ul>
              <li>Local-first, no cloud needed</li>
              <li>Smart multi-loan repayment split</li>
              <li>Optional Drive backup</li>
            </ul>
            <a class="link" href={`${base}products/tsumly/`}>Open Tsumly's site →</a>
          </div>
        </article>

        <article class="project-card kaizenly" data-category="mobile" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">K</span></div>
          <div class="body">
            <h3>Kaizenly</h3>
            <span class="tag">Android · Focus</span>
            <p>A free phone blocker that helps you stay off distracting apps — every feature free, no premium tier.</p>
            <ul>
              <li>Parachute streaks</li>
              <li>Routines</li>
              <li>Free, no premium</li>
            </ul>
            <a class="link" href={`${base}products/kaizenly/`}>Open Kaizenly's site →</a>
          </div>
        </article>

        <article class="project-card msgloop" data-category="mobile" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">M↻</span></div>
          <div class="body">
            <h3>MsgLoop</h3>
            <span class="tag">Android · Messaging</span>
            <p>A WhatsApp scheduled multi-message loop — send a set of messages to one number, up to 2,000 sends, on schedule.</p>
            <ul>
              <li>Multi-message loop to one number</li>
              <li>Scheduled tasks</li>
              <li>Resume from Recents</li>
            </ul>
            <a class="link" href={`${base}products/msgloop/`}>Open MsgLoop's site →</a>
          </div>
        </article>

        <article class="project-card cv" data-category="web" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">CV</span></div>
          <div class="body">
            <h3>CV Creator Pro</h3>
            <span class="tag">Web · Tool</span>
            <p>A one-page CV maker that runs entirely in the browser — fill it in, pick a look, download a clean A4 PDF.</p>
            <ul>
              <li>Pick theme and template</li>
              <li>One-page A4 PDF download</li>
              <li>Runs fully in the browser</li>
            </ul>
            <a class="link" href="https://resumemagicmaker.lovable.app/">Live site →</a>
          </div>
        </article>

        <article class="project-card nydrex" data-category="desktop" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Nx</span></div>
          <div class="body">
            <h3>Nydrex Suite</h3>
            <span class="tag">Desktop · Retail</span>
            <p>An Electron desktop suite for retail — point of sale and inventory, with customer and supplier ledgers and reporting.</p>
            <ul>
              <li>Checkout and inventory</li>
              <li>Customer and supplier ledgers</li>
              <li>Reporting and encrypted backup</li>
            </ul>
            <span class="nolink">Windows desktop app</span>
          </div>
        </article>

        <article class="project-card brew" data-category="web" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">B&amp;B</span></div>
          <div class="body">
            <h3>Brew &amp; Bean Cafe</h3>
            <span class="tag">Web · Assignment project — fully working end to end</span>
            <p>An animated cafe site with a menu and cart — your order is sent straight to the cafe as a WhatsApp message.</p>
            <ul>
              <li>Menu and cart</li>
              <li>Order sent as a WhatsApp message</li>
              <li>Fully animated</li>
            </ul>
            <a class="link" href="https://brew-and-bean-cafe-nadeemassignment.lovable.app/">Live site →</a>
          </div>
        </article>

        <article class="project-card demo" data-category="tools" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Ae</span></div>
          <div class="body">
            <h3>Aetheria Engine</h3>
            <span class="tag">Demo concept — not a shipped product.</span>
            <p>A concept demo exploring an engine-style interface.</p>
          </div>
        </article>

        <article class="project-card demo" data-category="tools" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Ds</span></div>
          <div class="body">
            <h3>DocuSense</h3>
            <span class="tag">Demo concept — not a shipped product.</span>
            <p>A concept demo for making sense of documents.</p>
          </div>
        </article>

        <article class="project-card demo" data-category="tools" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Mc</span></div>
          <div class="body">
            <h3>Monolith CLI</h3>
            <span class="tag">Demo concept — not a shipped product.</span>
            <p>A concept demo for a command-line tool.</p>
          </div>
        </article>

        <article class="project-card demo" data-category="tools" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Pc</span></div>
          <div class="body">
            <h3>PaperCraft UI</h3>
            <span class="tag">Demo concept — not a shipped product.</span>
            <p>A concept demo for a paper-inspired interface.</p>
          </div>
        </article>
      </div>

      <div class="sec-head concepts-head">
        <h2 class="display">Concepts</h2>
        <p class="count">5 concept demos — inspiration templates, cleaned and rebranded</p>
      </div>

      <div class="works-grid">
        <article class="project-card demo" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Tb</span></div>
          <div class="body">
            <h3>Tally Bar</h3>
            <span class="tag">Concept demo — an inspiration template, cleaned and rebranded to Nadeem Dev Apps.</span>
            <p>A desk status display with an LED pixel screen and a focus timer.</p>
            <a class="link" href={`${base}concepts/tally-bar/`}>Open the concept site →</a>
          </div>
        </article>

        <article class="project-card demo" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Lo</span></div>
          <div class="body">
            <h3>Look Out Below</h3>
            <span class="tag">Concept demo — an inspiration template, cleaned and rebranded to Nadeem Dev Apps.</span>
            <p>A tiny hand-drawn game about being small, quick and directly underneath a very clumsy sky.</p>
            <a class="link" href={`${base}concepts/look-out-below/`}>Open the concept site →</a>
          </div>
        </article>

        <article class="project-card demo" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">St</span></div>
          <div class="body">
            <h3>Stitch &amp; Tan</h3>
            <span class="tag">Concept demo — an inspiration template, cleaned and rebranded to Nadeem Dev Apps.</span>
            <p>Handmade leather pouches, cases and little things from a one-person studio, plus custom orders.</p>
            <a class="link" href={`${base}concepts/stitch-and-tan/`}>Open the concept site →</a>
          </div>
        </article>

        <article class="project-card demo" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Ps</span></div>
          <div class="body">
            <h3>ProductSite</h3>
            <span class="tag">Concept demo — an inspiration template, cleaned and rebranded to Nadeem Dev Apps.</span>
            <p>A product site for a calm team workspace — plan, build and ship from one place.</p>
            <a class="link" href={`${base}concepts/product-site/`}>Open the concept site →</a>
          </div>
        </article>

        <article class="project-card demo" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Pf</span></div>
          <div class="body">
            <h3>Portfolio</h3>
            <span class="tag">Concept demo — an inspiration template, cleaned and rebranded to Nadeem Dev Apps.</span>
            <p>A portfolio concept — oversized name, selected-work grid and case-study pages.</p>
            <a class="link" href={`${base}concepts/portfolio-concept/`}>Open the concept site →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <script>
    (function () {
      var buttons = document.querySelectorAll('.filter-btn');
      var cards = document.querySelectorAll('#works-grid .project-card');
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          buttons.forEach(function (b) {
            b.classList.remove('is-active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-pressed', 'true');
          var filter = btn.getAttribute('data-filter');
          cards.forEach(function (card) {
            var show = filter === 'all' || card.getAttribute('data-category') === filter;
            card.classList.toggle('is-hidden', !show);
          });
        });
      });
    })();
  </script>
</BaseLayout>
