---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  title="Apps & Websites by Nadeem Mazhar"
  description="Apps and websites by Nadeem Mazhar — Tsumly for loans and ledgers, Kaizenly for focus, and MsgLoop for WhatsApp scheduling. All free to use."
>
  <section>
    <div class="container">
      <div class="narrow">
      <h1>What we make</h1>
      <p class="muted">
        Small, local-first apps — each with its own dedicated site inside
        this one. Pick a product to open its pages.
      </p>
      </div>
      <div class="product-grid">
        <article class="card">
          <div class="product-icon" aria-hidden="true">T</div>
          <h2>Tsumly</h2>
          <p>Every amount adds up. A local-first personal expense and loan ledger, with a smart multi-loan repayment split and optional Google Drive backup.</p>
          <a href={`${base}products/tsumly/`}>Open Tsumly's site →</a>
        </article>
        <article class="card">
          <div class="product-icon" aria-hidden="true">K</div>
          <h2>Kaizenly</h2>
          <p>A strict, local-first focus guard — built from scratch to keep distracting apps shut when it matters.</p>
          <a href={`${base}products/kaizenly/`}>Open Kaizenly's site →</a>
        </article>
        <article class="card">
          <div class="product-icon" aria-hidden="true">M</div>
          <h2>MsgLoop</h2>
          <p>Repeat WhatsApp messages on a schedule, from a saved login on your phone.</p>
          <a href={`${base}products/msgloop/`}>Open MsgLoop's site →</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
