---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import LegalDoc from '../../../components/LegalDoc.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<ProductLayout
  title="MsgLoop Privacy Policy"
  description="Privacy policy for MsgLoop, the WhatsApp sender for Android — tasks and login stay on your phone, with no account and no tracking."
  productName="MsgLoop"
  productBase={`${base}products/msgloop/`}
>
  <LegalDoc
    title="MsgLoop Privacy Policy"
    intro="MsgLoop collects no personal data. Everything stays on your phone."
    sections={[
      {
        heading: 'The short version',
        body: 'MsgLoop is private by design. It does not collect, track, profile, or upload personal data. No MsgLoop account or signup is required, and there are no analytics, advertising, or tracking SDKs. Your scheduled tasks, login session, and history stay on your device. The only network use is WhatsApp Web itself — your messages never leave the phone except through WhatsApp.',
      },
      {
        heading: 'What stays on your device',
        body: 'Your scheduled tasks, task history, and login state are stored only on your phone. Android automatic backup is disabled for the app, so the operating system never silently copies your data to the cloud. Uninstalling the app (or clearing its data) removes them.',
      },
      {
        heading: 'WhatsApp login',
        body: 'You log in to WhatsApp Web inside the app by scanning a QR code. The session lives in the app\u2019s WebView on your phone. MsgLoop never asks for your WhatsApp password and never sees it.',
      },
      {
        heading: 'Permissions that stay on the device',
        body: 'MsgLoop needs a few permissions to do its job, and all of them work locally. Internet access reaches WhatsApp Web. The foreground service runs scheduled sends. Notifications keep you informed, the battery-optimisation exemption keeps alarms firing, boot restores re-register alarms after a restart, and exact alarms fire sends at the time you picked. MsgLoop asks for no contacts, no SMS, no storage, and no accessibility service. You grant each permission yourself, and you can revoke them at any time in your phone\u2019s settings \u2014 revoking them may stop sending from working.',
      },
      {
        heading: 'Your choices',
        body: 'Your data is yours. You can delete tasks and history in the app, log out of WhatsApp Web, or uninstall the app at any time to remove its local data from the device.',
      },
      {
        heading: 'Changes to this policy',
        body: 'This policy may be updated from time to time; the version on this page is always the current one. If the app ever starts handling data in a new way, the policy will say so.',
      },
      {
        heading: 'Contact',
        body: 'Questions about privacy? Email nadeem.devapps@gmail.com.',
      },
    ]}
  />
</ProductLayout>
