---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteUrl = `https://nadeemdevapps.github.io${base}`;
const personId = `${siteUrl}#nadeem`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': `${siteUrl}#organization`,
        name: 'Nadeem Dev Apps',
        url: siteUrl,
        logo: `${siteUrl}logo.svg`,
        sameAs: ['https://github.com/nadeemdevapps'],
        founder: { '@id': personId },
      },
      {
        '@type': 'WebSite',
        '@id': `${siteUrl}#website`,
        name: 'Nadeem Dev Apps',
        url: siteUrl,
        publisher: { '@id': `${siteUrl}#organization` },
      },
      {
        '@type': 'Person',
        '@id': personId,
        name: 'Nadeem Mazhar',
        jobTitle: 'Solo Developer',
        description:
          'Solo developer. I plan first, then build with AI — phase by phase, tested. Six shipped products, built for real problems I had myself.',
        url: `${siteUrl}about/`,
        sameAs: ['https://github.com/nadeemdevapps'],
      },
    ],
  },
];
---

<BaseLayout
  title="Nadeem Mazhar — Solo Developer"
  description="Nadeem Mazhar — a solo developer building with AI, phase by phase, tested. Selected work: Tsumly, Kaizenly, MsgLoop, CV Creator Pro, Nydrex Suite, and Brew & Bean Cafe."
  jsonLd={jsonLd}
>
  <header class="hero" id="top">
    <div class="fields" aria-hidden="true">
      <div class="field purple"></div>
      <div class="field green"></div>
      <div class="field amber"></div>
      <div class="field blue"></div>
    </div>
    <div class="hero-inner">
      <h1 class="display" aria-label="Nadeem Mazhar">
        <span class="word"><span>Nadeem</span></span>
        <span class="word"><span>Mazhar</span></span>
      </h1>
      <p class="hero-intro">
        Solo developer. I plan first, then build with AI — phase by phase, tested.
        <span class="dim">Six shipped products, built for real problems I had myself.</span>
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#work">See the work</a>
        <a class="btn btn-secondary" href={`${base}contact/`}>Open to internships</a>
      </div>
    </div>
  </header>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track" id="marqueeTrack">
      <div class="run">AI-first building <span class="dot">●</span> Strategic planning <span class="dot">●</span> Phased implementation <span class="dot">●</span> Learning in public <span class="dot">●</span> Experiments</div>
    </div>
  </div>

  <section id="work">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="display">Selected work</h2>
        <p class="count">10 projects</p>
      </div>
      <div class="works-grid">
        <article class="project-card tsumly" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Ts</span></div>
          <div class="body">
            <h3>Tsumly</h3>
            <span class="tag">Android · Finance</span>
            <p>A local-first expense tracker with a smart multi-loan repayment split — the finance app I needed, built for myself.</p>
            <ul>
              <li>Local-first, no cloud needed</li>
              <li>Smart multi-loan repayment split</li>
              <li>Optional Drive backup</li>
            </ul>
            <a class="link" href={`${base}products/tsumly/`}>Open Tsumly's site →</a>
          </div>
        </article>

        <article class="project-card kaizenly" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">K</span></div>
          <div class="body">
            <h3>Kaizenly</h3>
            <span class="tag">Android · Focus</span>
            <p>A free phone blocker that helps you stay off distracting apps — every feature free, no premium tier.</p>
            <ul>
              <li>Parachute streaks</li>
              <li>Routines</li>
              <li>Free, no premium</li>
            </ul>
            <a class="link" href={`${base}products/kaizenly/`}>Open Kaizenly's site →</a>
          </div>
        </article>

        <article class="project-card msgloop" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">M↻</span></div>
          <div class="body">
            <h3>MsgLoop</h3>
            <span class="tag">Android · Messaging</span>
            <p>A WhatsApp scheduled multi-message loop — send a set of messages to one number, up to 2,000 sends, on schedule.</p>
            <ul>
              <li>Multi-message loop to one number</li>
              <li>Scheduled tasks</li>
              <li>Resume from Recents</li>
            </ul>
            <a class="link" href={`${base}products/msgloop/`}>Open MsgLoop's site →</a>
          </div>
        </article>

        <article class="project-card cv" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">CV</span></div>
          <div class="body">
            <h3>CV Creator Pro</h3>
            <span class="tag">Web · Tool</span>
            <p>A one-page CV maker that runs entirely in the browser — fill it in, pick a look, download a clean A4 PDF.</p>
            <ul>
              <li>Pick theme and template</li>
              <li>One-page A4 PDF download</li>
              <li>Runs fully in the browser</li>
            </ul>
            <a class="link" href="https://resumemagicmaker.lovable.app/">Live site →</a>
          </div>
        </article>

        <article class="project-card nydrex" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Nx</span></div>
          <div class="body">
            <h3>Nydrex Suite</h3>
            <span class="tag">Desktop · Retail</span>
            <p>An Electron desktop suite for retail — point of sale and inventory, with customer and supplier ledgers and reporting.</p>
            <ul>
              <li>Checkout and inventory</li>
              <li>Customer and supplier ledgers</li>
              <li>Reporting and encrypted backup</li>
            </ul>
            <span class="nolink">Windows desktop app</span>
          </div>
        </article>

        <article class="project-card brew" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">B&amp;B</span></div>
          <div class="body">
            <h3>Brew &amp; Bean Cafe</h3>
            <span class="tag">Web · Assignment project — fully working end to end</span>
            <p>An animated cafe site with a menu and cart — your order is sent straight to the cafe as a WhatsApp message.</p>
            <ul>
              <li>Menu and cart</li>
              <li>Order sent as a WhatsApp message</li>
              <li>Fully animated</li>
            </ul>
            <a class="link" href="https://brew-and-bean-cafe-nadeemassignment.lovable.app/">Live site →</a>
          </div>
        </article>

        <article class="project-card demo" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Ae</span></div>
          <div class="body">
            <h3>Aetheria Engine</h3>
            <span class="tag">Demo concept — not a shipped product.</span>
            <p>A concept demo exploring an engine-style interface.</p>
          </div>
        </article>

        <article class="project-card demo" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Ds</span></div>
          <div class="body">
            <h3>DocuSense</h3>
            <span class="tag">Demo concept — not a shipped product.</span>
            <p>A concept demo for making sense of documents.</p>
          </div>
        </article>

        <article class="project-card demo" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Mc</span></div>
          <div class="body">
            <h3>Monolith CLI</h3>
            <span class="tag">Demo concept — not a shipped product.</span>
            <p>A concept demo for a command-line tool.</p>
          </div>
        </article>

        <article class="project-card demo" data-tilt>
          <div class="field-img" aria-hidden="true"><span class="glyph">Pc</span></div>
          <div class="body">
            <h3>PaperCraft UI</h3>
            <span class="tag">Demo concept — not a shipped product.</span>
            <p>A concept demo for a paper-inspired interface.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container narrow" style="text-align: center;">
      <p class="honest" style="max-width: 620px; margin: 0 auto 24px;">
        I build for myself first. If a paid feature costs nothing to run — no server — it should be free.
      </p>
      <p><a href={`${base}about/`}>More about Nadeem →</a></p>
    </div>
  </section>

  <script>
    (function () {
      var track = document.getElementById('marqueeTrack');
      if (!track || !track.children[0]) return;
      var clone = track.children[0].cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);
    })();
  </script>
</BaseLayout>
