---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  title="Home"
  description="Nadeem Dev Apps builds small, local-first apps — Tsumly, a personal expense and loan ledger, and Kaizenly, a strict focus guard."
>
  <section class="hero">
    <div class="container">
      <Logo size={48} />
      <span class="eyebrow">Portfolio · Products</span>
      <h1>Small apps,<br />built for <span class="accent">real life.</span></h1>
      <p class="muted">
        Nadeem Dev Apps builds local-first tools that solve one problem well —
        starting with money and focus.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`${base}products/tsumly/`}>Meet Tsumly</a>
        <a class="btn btn-secondary" href={`${base}products/kaizenly/`}>Kaizenly</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <span class="eyebrow">Products</span>
      <h2>What we make</h2>
      <div class="product-grid">
        <article class="card">
          <div class="product-icon" aria-hidden="true">T</div>
          <h3>Tsumly</h3>
          <p>Every amount adds up. A local-first personal expense and loan ledger, with a smart multi-loan repayment split and optional Google Drive backup.</p>
          <a href={`${base}products/tsumly/`}>Learn more →</a>
        </article>
        <article class="card">
          <div class="product-icon" aria-hidden="true">K</div>
          <h3>Kaizenly</h3>
          <p>A strict, local-first focus guard — built from scratch to keep distracting apps shut when it matters.</p>
          <a href={`${base}products/kaizenly/`}>Learn more →</a>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <span class="eyebrow">About</span>
      <h2>Built by one developer, for himself first.</h2>
      <p class="muted">
        Every app here started as a personal problem — a ledger that never
        added up, a phone that never stayed quiet. They ship when they work
        in daily use, not before.
      </p>
    </div>
  </section>
</BaseLayout>
