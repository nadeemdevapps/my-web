---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteUrl = `https://nadeemdevapps.github.io${base}`;
const personId = `${siteUrl}#nadeem`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': `${siteUrl}#organization`,
        name: 'Nadeem Dev Apps',
        url: siteUrl,
        logo: `${siteUrl}logo.svg`,
        sameAs: ['https://github.com/nadeemdevapps'],
        founder: { '@id': personId },
      },
      {
        '@type': 'WebSite',
        '@id': `${siteUrl}#website`,
        name: 'Nadeem Dev Apps',
        url: siteUrl,
        publisher: { '@id': `${siteUrl}#organization` },
      },
      {
        '@type': 'Person',
        '@id': personId,
        name: 'Nadeem Mazhar',
        jobTitle: 'Solo Developer',
        description:
          'Solo developer in Pakistan. Builds websites, Windows apps, Android apps, and backends — local-first or cloud, whichever the project needs — with AI doing the heavy lifting under his direction.',
        url: `${siteUrl}about/`,
        sameAs: ['https://github.com/nadeemdevapps'],
      },
    ],
  },
];
---

<BaseLayout
  title="Nadeem Mazhar — Solo Developer, Pakistan"
  description="Nadeem Mazhar — a solo developer in Pakistan building websites, Windows apps, Android apps, and backends. Selected work: Tsumly, Kaizenly, and MsgLoop."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <Logo size={48} />
        <h1>I'm Nadeem Mazhar —<br />I build apps and websites for <span class="accent">real life.</span></h1>
        <p class="muted">
          Solo developer in Pakistan. I plan, design, and ship websites,
          Windows apps, Android apps, and backends — local-first or cloud,
          whichever the project needs — with AI doing the heavy lifting under
          my direction.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#work">See my work</a>
          <a class="btn btn-secondary" href={`${base}contact/`}>Get in touch</a>
        </div>
      </div>
      <aside class="hero-visual">
        <div class="hero-card">
          <p class="kicker">Selected work</p>
          <ul class="hero-work">
            <li>
              <a href={`${base}products/tsumly/`}>
                <span class="product-icon" aria-hidden="true">T</span>
                <span class="hero-work-text">
                  <strong>Tsumly</strong>
                  <span>A money ledger that adds up.</span>
                </span>
              </a>
            </li>
            <li>
              <a href={`${base}products/kaizenly/`}>
                <span class="product-icon" aria-hidden="true">K</span>
                <span class="hero-work-text">
                  <strong>Kaizenly</strong>
                  <span>A focus guard that means it.</span>
                </span>
              </a>
            </li>
            <li>
              <a href={`${base}products/msgloop/`}>
                <span class="product-icon" aria-hidden="true">M</span>
                <span class="hero-work-text">
                  <strong>MsgLoop</strong>
                  <span>A WhatsApp sender for Android.</span>
                </span>
              </a>
            </li>
          </ul>
          <p class="hero-work-all"><a href={`${base}products/`}>All products →</a></p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section-alt" id="work">
    <div class="container">
      <p class="kicker">Selected work</p>
      <h2>What I've built</h2>
      <div class="product-grid">
        <div>
          <h3>Tsumly</h3>
          <p class="lede">
            A <strong>local-first money ledger</strong> — every amount adds up.
            Track expenses and loans on your own device, with an optional
            <strong>encrypted Google Drive backup</strong>.
          </p>
          <ul class="feature-list">
            <li><strong>Smart multi-loan repayment split</strong> — one repayment spread across your loans, the fair way.</li>
            <li><strong>Pre-app loans</strong> — record loans from before the app without moving your balance.</li>
            <li><strong>Person profiles</strong> — every loan tied to a person, with their totals at a glance.</li>
          </ul>
          <p><a href={`${base}products/tsumly/`}>Learn more →</a></p>
        </div>
        <div>
          <h3>Kaizenly</h3>
          <p class="lede">
            A <strong>strict, local-first focus guard</strong> — timed sessions
            that keep distracting apps shut when it matters.
          </p>
          <ul class="feature-list">
            <li><strong>Sessions ("bags")</strong> — 15 min, 45 min, 3 h, or a custom length (3–12 h, premium).</li>
            <li><strong>Parachute exit cost</strong> — quitting early costs something, so it stays a deliberate choice.</li>
            <li><strong>Streaks, routines, and stats</strong> — the progress building up, visible day by day.</li>
          </ul>
          <p><a href={`${base}products/kaizenly/`}>Learn more →</a></p>
        </div>
        <div>
          <h3>MsgLoop</h3>
          <p class="lede">
            A <strong>WhatsApp sender for Android</strong> — one message, sent
            many times, right now or on a schedule.
          </p>
          <ul class="feature-list">
            <li><strong>Schedule for later</strong> — pick a date and time; an exact alarm sends when you said it would.</li>
            <li><strong>A queue that survives anything</strong> — tasks live on the phone, through restarts and app kills.</li>
            <li><strong>Private by design</strong> — no account, no server, no tracking.</li>
          </ul>
          <p><a href={`${base}products/msgloop/`}>Learn more →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container narrow">
      <p class="kicker">What I do</p>
      <h2>Planning, design, and shipping — with AI.</h2>
      <p class="lede">
        I explore a problem until I understand it, plan the shape of the
        answer, design the interface, and ship it — with <strong>AI tools
        doing the heavy lifting</strong> under my direction. The apps I ship
        are <strong>local-first by design</strong> — no accounts, no tracking,
        no ads — because that's the right call for a personal tool, not
        because it's all I can build.
      </p>
      <ul class="feature-list">
        <li><strong>Exploration</strong> — I research what's out there, what fails, and what's missing before I build anything.</li>
        <li><strong>AI-assisted development</strong> — I direct the build and review every step; AI writes the bulk of the code, I own the decisions.</li>
        <li><strong>UI design</strong> — interfaces I design myself: clean, calm, and built to be used every day.</li>
        <li><strong>Planning &amp; brainstorming</strong> — documentation and a clear plan come before the first line of code.</li>
        <li><strong>Problem-solving</strong> — the hard part isn't the code, it's finding the right shape for the answer.</li>
        <li><strong>Security analysis</strong> — I follow security protocols properly, with AI help, on every build.</li>
      </ul>
    </div>
  </section>

  <section class="section-alt">
    <div class="container narrow">
      <p class="kicker">About</p>
      <h2>A solo developer, building for himself first.</h2>
      <p class="muted">
        I'm Nadeem Mazhar, a solo developer in Pakistan. I build the tools I
        wish existed — planned, documented, reviewed, and shipped. Tsumly and
        Kaizenly started as personal problems: a ledger that never added up, a
        phone that never stayed quiet. They ship when they work in daily use,
        not before.
      </p>
      <p><a href={`${base}about/`}>More about Nadeem →</a></p>
    </div>
  </section>

  <section>
    <div class="container narrow">
      <h2>Have an idea?</h2>
      <p class="muted">
        Questions, feedback, or just want to say hi — get in touch.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`${base}contact/`}>Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>
