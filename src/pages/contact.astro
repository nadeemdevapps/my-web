---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Nadeem Mazhar — Solo Developer"
  description="Contact Nadeem Mazhar — open to internships in tech or in the numbers side of a business. Email and GitHub links are on this page."
>
  <section class="page-top">
    <div class="wrap">
      <div class="cta-card reveal">
        <h1 class="display">Open to internships</h1>
        <p>I'm looking for an internship where I can plan, build, and learn in a real team — in tech, or in the numbers side of a business.</p>
        <p class="areas">Software house · Bank · Company · Bookkeeping</p>
        <div class="cta-buttons">
          <a class="btn light" href="mailto:nadeem.devapps@gmail.com">nadeem.devapps@gmail.com</a>
          <a class="btn outline-light" href="https://github.com/nadeemdevapps">GitHub — nadeemdevapps</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container narrow">
      <h2>Write to me.</h2>
      <p class="lede">
        I read every message myself. Write about an app — a bug, a feature
        idea, or something that didn't work the way you expected — or about a
        website or app you'd like built.
      </p>
      <p class="muted" style="max-width: 560px;">
        Send a message below and it will open in your mail app, ready to send.
      </p>

      <form id="contact-form" class="contact-form">
        <div class="field">
          <label for="contact-name">Your name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="contact-email">Your email</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" required></textarea>
        </div>
        <button class="btn btn-primary" type="submit">Send via email</button>
        <p id="form-status" class="form-note" role="status"></p>
        <noscript>
          <p class="form-note">
            The form needs JavaScript to open your mail app — or email us
            directly at nadeem.devapps@gmail.com.
          </p>
        </noscript>
      </form>
    </div>
  </section>

  <script is:inline>
    // No backend: the form composes a mailto link and opens the visitor's
    // own mail app, with the message ready to send.
    (function () {
      var form = document.getElementById('contact-form');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var name = document.getElementById('contact-name').value.trim();
        var email = document.getElementById('contact-email').value.trim();
        var message = document.getElementById('contact-message').value.trim();
        var subject = 'Website contact from ' + name;
        var body = 'Name: ' + name + '\nEmail: ' + email + '\n\n' + message;
        var status = document.getElementById('form-status');
        if (status) status.textContent = 'Opening your mail app — press Send there to deliver your message.';
        window.location.href =
          'mailto:nadeem.devapps@gmail.com?subject=' + encodeURIComponent(subject) +
          '&body=' + encodeURIComponent(body);
      });
    })();
  </script>
</BaseLayout>
