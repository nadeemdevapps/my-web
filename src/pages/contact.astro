---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contact Nadeem Dev Apps — email or GitHub."
>
  <section>
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Talk to us.</h1>
      <p class="muted" style="max-width: 560px;">
        Questions, bug reports, or ideas for the apps — email is the fastest
        way to reach us.
      </p>
      <div class="product-grid">
        <article class="card">
          <h3>Email</h3>
          <p>For support, feedback, and everything else.</p>
          <a class="btn btn-primary" href="mailto:nadeem.devapps@gmail.com">nadeem.devapps@gmail.com</a>
        </article>
        <article class="card">
          <h3>GitHub</h3>
          <p>Source code, releases, and issue reports for the apps.</p>
          <a class="btn btn-secondary" href="https://github.com/nadeemdevapps">github.com/nadeemdevapps</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
