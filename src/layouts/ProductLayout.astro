---
import BaseLayout from './BaseLayout.astro';
import ProductNav from '../components/ProductNav.astro';

interface Props {
  title: string;
  description?: string;
  productName: string;
  productBase: string;
}

const { title, description, productName, productBase } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <ProductNav productName={productName} productBase={productBase} />
  <slot />
</BaseLayout>
