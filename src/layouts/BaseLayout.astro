---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  noMainChrome?: boolean;
}

const { title, description = 'Nadeem Dev Apps — small, local-first apps.', jsonLd = [], noindex = false, noMainChrome = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Absolute URLs for canonical / Open Graph: Astro.site is the production
// origin (https://nadeemdevapps.github.io); the pathname carries /my-web.
const siteUrl = Astro.site?.href ?? 'https://nadeemdevapps.github.io/';
// Canonical: force a trailing slash so every page matches the slashed form
// used by the sitemap and llms.txt (Home is /my-web/, never bare /my-web).
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(pathname, siteUrl).href;
// The 404 page has no canonical: /my-web/404/ is a dead URL (returns 404).
const is404 = Astro.url.pathname.replace(/\/$/, '').endsWith('/404');
const ogImage = new URL(`${base}og-image.png`, siteUrl).href;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2efe9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171512" />
    <title>{title} — Nadeem Dev Apps</title>
    <meta name="description" content={description} />
    {!is404 && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={`${title} — Nadeem Dev Apps`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!is404 && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nadeem Dev Apps" />
    <meta property="og:site_name" content="Nadeem Dev Apps" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Nadeem Dev Apps`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Set the theme before first paint: saved choice, else system preference.
      try {
        const saved = localStorage.getItem('nda-theme');
        const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    {!noMainChrome && (
    <header class="site-nav" id="top">
      <nav class="pill-nav" aria-label="Main">
        <a href={`${base}`}>Home</a>
        <a href={`${base}products/`}>Work</a>
        <a href={`${base}about/`}>About</a>
        <a href={`${base}contact/`}>Contact</a>
        <span class="nav-divider" aria-hidden="true"></span>
        <button class="theme-toggle" type="button" aria-label="Switch to dark theme">
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
        </button>
      </nav>
    </header>
    )}

    <script is:inline>
      // Theme toggle: flip data-theme and remember the choice.
      (function () {
        var btn = document.querySelector('.theme-toggle');
        if (!btn) return;
        function label(theme) { return theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'; }
        btn.addEventListener('click', function () {
          var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('nda-theme', next); } catch (e) {}
          btn.setAttribute('aria-label', label(next));
        });
        btn.setAttribute('aria-label', label(document.documentElement.getAttribute('data-theme') || 'light'));
      })();
    </script>

    <main id="main">
      <slot />
    </main>

    {!noMainChrome && (
    <footer class="site-footer">
      <div class="container">
        <p class="footer-brand">Nadeem Dev Apps</p>
        <p><a href="https://github.com/nadeemdevapps">GitHub</a></p>
        <p>© 2026 Nadeem Dev Apps</p>
      </div>
      <div class="foot-wordmark" aria-hidden="true"><span class="foot-letter">N<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span><span class="foot-letter">A<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span><span class="foot-letter">D<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span><span class="foot-letter">E<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span><span class="foot-letter">E<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span><span class="foot-letter">M<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span></div>
    </footer>
    )}

    <script is:inline>
      // Card tilt + scroll reveal — ported from the redesign mockup.
      // Tilt runs only with a fine pointer and no reduced-motion request;
      // reveal falls back to showing everything when IntersectionObserver
      // is unavailable or motion is reduced.
      (function () {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const hoverable = window.matchMedia('(hover: hover)').matches;
        if (!reduce && hoverable) {
          document.querySelectorAll('[data-tilt]').forEach(function (card) {
            card.addEventListener('mousemove', function (e) {
              const r = card.getBoundingClientRect();
              const x = (e.clientX - r.left) / r.width - 0.5;
              const y = (e.clientY - r.top) / r.height - 0.5;
              card.style.transform =
                'perspective(900px) rotateX(' + (-y * 4).toFixed(2) + 'deg) rotateY(' +
                (x * 4).toFixed(2) + 'deg) translateY(-5px)';
            });
            card.addEventListener('mouseleave', function () {
              card.style.transform = '';
            });
          });
        }
        const reveals = document.querySelectorAll('.reveal');
        if (reduce || !('IntersectionObserver' in window)) {
          reveals.forEach(function (el) { el.classList.add('in'); });
        } else {
          const io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12 });
          reveals.forEach(function (el) { io.observe(el); });
        }
      })();
    </script>
    <style>
      /* Skip link: visually hidden until focused (WCAG 2.4.1). */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1rem;
        border-radius: 0 0 8px 0;
        background: var(--color-primary);
        color: var(--color-on-primary);
        font-weight: 600;
        text-decoration: none;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
