---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  noMainChrome?: boolean;
}

const { title, description = 'Nadeem Dev Apps — small, local-first apps.', jsonLd = [], noindex = false, noMainChrome = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Active pill-nav link, from the current path (trailing slash forced).
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isHome = path === base;
const isProducts = path === `${base}products/`;
const isAbout = path === `${base}about/`;
const isContact = path === `${base}contact/`;
// Absolute URLs for canonical / Open Graph: Astro.site is the production
// origin (https://nadeemdevapps.github.io); the pathname carries /my-web.
const siteUrl = Astro.site?.href ?? 'https://nadeemdevapps.github.io/';
// Canonical: force a trailing slash so every page matches the slashed form
// used by the sitemap and llms.txt (Home is /my-web/, never bare /my-web).
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(pathname, siteUrl).href;
// The 404 page has no canonical: /my-web/404/ is a dead URL (returns 404).
const is404 = Astro.url.pathname.replace(/\/$/, '').endsWith('/404');
const ogImage = new URL(`${base}og-image.png`, siteUrl).href;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f5f4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f0f0f" />
    <title>{title} — Nadeem Dev Apps</title>
    <meta name="description" content={description} />
    {!is404 && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={`${title} — Nadeem Dev Apps`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!is404 && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nadeem Dev Apps" />
    <meta property="og:site_name" content="Nadeem Dev Apps" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Nadeem Dev Apps`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Set the theme before first paint: saved choice, else system preference.
      try {
        const saved = localStorage.getItem('nda-theme');
        const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!noMainChrome && (
    <header class="site-nav" id="top">
      <div class="container">
        <a class="wordmark" href={`${base}`}><Logo size={28} /> Nadeem Dev Apps</a>
        <nav class="pill-nav" aria-label="Main">
          <a href={`${base}`} aria-current={isHome ? 'page' : undefined}>Home</a>
          <a href={`${base}products/`} aria-current={isProducts ? 'page' : undefined}>Products</a>
          <a href={`${base}about/`} aria-current={isAbout ? 'page' : undefined}>About</a>
          <a href={`${base}contact/`} aria-current={isContact ? 'page' : undefined}>Contact</a>
        </nav>
        <div class="nav-actions">
          <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg class="icon-menu" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18 M3 12h18 M3 18h18" /></svg>
            <svg class="icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18 M6 6l12 12" /></svg>
          </button>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false">
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 1v2 M12 21v2 M4.22 4.22l1.42 1.42 M18.36 18.36l1.42 1.42 M1 12h2 M21 12h2 M4.22 19.78l1.42-1.42 M18.36 5.64l1.42-1.42" /></svg>
          </button>
          <a class="btn btn-primary nav-cta" href={`${base}contact/`}>Get in touch</a>
        </div>
      </div>
      <div class="mobile-menu" id="mobile-menu">
        <div class="container">
          <nav aria-label="Mobile">
            <a href={`${base}`}>Home</a>
            <a href={`${base}products/`}>Products</a>
            <a href={`${base}about/`}>About</a>
            <a href={`${base}contact/`}>Contact</a>
          </nav>
        </div>
      </div>
    </header>
    )}

    <main id="main">
      <slot />
    </main>

    {!noMainChrome && (
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="wordmark" href={`${base}`} style="font-size: 18px;"><Logo size={22} /> Nadeem Dev Apps</a>
            <p>Local-first tools that solve one problem well.</p>
            <a class="footer-mail" href="mailto:nadeem.devapps@gmail.com"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg> nadeem.devapps@gmail.com</a>
          </div>
          <nav aria-label="Products">
            <h3>Products</h3>
            <a href={`${base}products/`}>All products</a>
            <a href={`${base}products/tsumly/`}>Tsumly</a>
            <a href={`${base}products/kaizenly/`}>Kaizenly</a>
            <a href={`${base}products/msgloop/`}>MsgLoop</a>
          </nav>
          <nav aria-label="Site">
            <h3>Site</h3>
            <a href={`${base}`}>Home</a>
            <a href={`${base}products/`}>Products</a>
            <a href={`${base}about/`}>About</a>
            <a href={`${base}contact/`}>Contact</a>
          </nav>
          <nav aria-label="Machine">
            <h3>Machine</h3>
            <a href={`${base}llms.txt`}>llms.txt</a>
            <a href={`${base}robots.txt`}>robots.txt</a>
            <a href={`${base}sitemap.xml`}>sitemap.xml</a>
          </nav>
          <nav aria-label="Legal">
            <h3>Legal</h3>
            <a href={`${base}privacy/`}>Privacy</a>
            <a href={`${base}terms/`}>Terms</a>
          </nav>
        </div>
        <div class="footer-bottom">
          <span>© 2026 Nadeem Dev Apps — Built with Astro.</span>
          <div class="footer-bottom-links">
            <a href="https://github.com/nadeemdevapps">GitHub</a>
            <a href="#top">Back to top ↑</a>
          </div>
        </div>
      </div>
    </footer>
    )}

    <script is:inline>
      // Theme toggle: light <-> dark, saved for the next visit.
      (function () {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const sync = () => {
          const dark = document.documentElement.getAttribute('data-theme') === 'dark';
          btn.setAttribute('aria-label', dark ? 'Toggle light mode' : 'Toggle dark mode');
          btn.setAttribute('aria-pressed', String(dark));
        };
        sync();
        btn.addEventListener('click', () => {
          const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('nda-theme', next); } catch (e) {}
          sync();
        });
      })();

      // Mobile menu: hamburger <-> panel, below 840px only.
      (function () {
        const btn = document.getElementById('menu-toggle');
        const menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;
        const setOpen = (open) => {
          menu.classList.toggle('open', open);
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        };
        btn.addEventListener('click', () => {
          setOpen(!menu.classList.contains('open'));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.classList.contains('open')) {
            setOpen(false);
            btn.focus();
          }
        });
        menu.addEventListener('click', (e) => {
          if (e.target.closest('a')) {
            setOpen(false);
          }
        });
      })();
    </script>
    <style>
      /* Skip link: visually hidden until focused (WCAG 2.4.1). */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1rem;
        border-radius: 0 0 8px 0;
        background: var(--color-primary);
        color: var(--color-on-primary);
        font-weight: 600;
        text-decoration: none;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
