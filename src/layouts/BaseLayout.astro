---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  noMainChrome?: boolean;
}

const { title, description = 'Nadeem Dev Apps — small, local-first apps.', jsonLd = [], noindex = false, noMainChrome = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Absolute URLs for canonical / Open Graph: Astro.site is the production
// origin (https://nadeem-dev-apps.pages.dev/); the pathname carries the
// site base.
const siteUrl = Astro.site?.href ?? 'https://nadeem-dev-apps.pages.dev/';
// Canonical: force a trailing slash so every page matches the slashed form
// used by the sitemap and llms.txt (Home is /, never a bare path).
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(pathname, siteUrl).href;
// Nav current-page match (D6): compare trailing-slashed paths so the
// link for the page being viewed gets aria-current="page".
const isCurrent = (href: string) => {
  const p = Astro.url.pathname.replace(/\/?$/, '/');
  const h = href.replace(/\/?$/, '/');
  return p === h;
};
// The 404 page has no canonical: /404/ is a dead URL (returns 404).
const is404 = Astro.url.pathname.replace(/\/$/, '').endsWith('/404');
const ogImage = new URL(`${base}og-image.png?v=3`, siteUrl).href;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- One script-driven theme-color meta: the head theme script sets its
         content to the effective theme before first paint, and the toggle
         script updates it on every change. Media-driven metas cannot
         follow a manual theme override, so they are not used. -->
    <meta name="theme-color" content="#f2efe9" />
    <title>{title} — Nadeem Dev Apps</title>
    <meta name="description" content={description} />
    {!is404 && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={`${title} — Nadeem Dev Apps`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!is404 && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nadeem Dev Apps" />
    <meta property="og:site_name" content="Nadeem Dev Apps" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Nadeem Dev Apps`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Set the theme before first paint. The stored mode is 'light',
      // 'dark' or 'system' under the shared key 'nda-theme' (same key as
      // the Tsumly and Kaizenly sites); anything else falls back to
      // system-following. data-theme is the effective theme,
      // data-theme-mode the stored mode; the theme-color meta follows
      // the effective theme.
      (function () {
        try {
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          var meta = document.querySelector('meta[name="theme-color"]');
          function apply(mode) {
            var theme =
              mode === 'dark' ? 'dark' : mode === 'light' ? 'light' : mq.matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.setAttribute('data-theme-mode', mode);
            if (meta) meta.setAttribute('content', theme === 'dark' ? '#171512' : '#f2efe9');
          }
          var saved = localStorage.getItem('nda-theme');
          var mode =
            saved === 'dark' || saved === 'light' || saved === 'system' ? saved : 'system';
          apply(mode);
          mq.addEventListener('change', function () {
            if ((localStorage.getItem('nda-theme') || 'system') === 'system') apply('system');
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    {!noMainChrome && (
    <header class="site-nav" id="top">
      <nav class="pill-nav" aria-label="Main">
        <a href={`${base}`} aria-current={isCurrent(`${base}`) ? 'page' : undefined}>Home</a>
        <a href={`${base}products/`} aria-current={isCurrent(`${base}products/`) ? 'page' : undefined}>Work</a>
        <a href={`${base}about/`} aria-current={isCurrent(`${base}about/`) ? 'page' : undefined}>About</a>
        <a href={`${base}contact/`} aria-current={isCurrent(`${base}contact/`) ? 'page' : undefined}>Contact</a>
        <span class="nav-divider" aria-hidden="true"></span>
        <button class="theme-toggle" type="button" aria-label="Switch to dark theme">
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
          <svg class="icon-system" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
        </button>
      </nav>
    </header>
    )}

    <script is:inline>
      // Theme toggle: cycle light → dark → system and remember the choice
      // under the shared key 'nda-theme' (same key as the Tsumly and
      // Kaizenly sites). In system mode the effective theme follows the
      // OS preference; the toggle icon always matches the effective theme.
      (function () {
        var btn = document.querySelector('.theme-toggle');
        if (!btn) return;
        var order = ['light', 'dark', 'system'];
        var meta = document.querySelector('meta[name="theme-color"]');
        function label(mode) {
          return mode === 'dark'
            ? 'Switch to system theme'
            : mode === 'system'
              ? 'Switch to light theme'
              : 'Switch to dark theme';
        }
        // Title names the current mode (D11): in system mode the icon
        // alone can't say so, and the tooltip makes it explicit.
        function modeTitle(mode) {
          return mode === 'dark'
            ? 'Dark theme'
            : mode === 'system'
              ? 'System theme — following your device'
              : 'Light theme';
        }
        function apply(mode) {
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          var theme =
            mode === 'dark' ? 'dark' : mode === 'light' ? 'light' : mq.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.setAttribute('data-theme-mode', mode);
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#171512' : '#f2efe9');
          try {
            localStorage.setItem('nda-theme', mode);
          } catch (e) {}
          btn.setAttribute('aria-label', label(mode));
          btn.setAttribute('title', modeTitle(mode));
        }
        btn.addEventListener('click', function () {
          var current = document.documentElement.getAttribute('data-theme-mode') || 'system';
          var next = order[(order.indexOf(current) + 1) % order.length];
          apply(next);
        });
        btn.setAttribute(
          'aria-label',
          label(document.documentElement.getAttribute('data-theme-mode') || 'system'),
        );
        btn.setAttribute(
          'title',
          modeTitle(document.documentElement.getAttribute('data-theme-mode') || 'system'),
        );
      })();
    </script>

    <main id="main">
      <slot />
    </main>

    {!noMainChrome && (
    <footer class="site-footer">
      <div class="container">
        <p class="footer-brand">Nadeem Dev Apps</p>
        <p><a href="https://github.com/nadeemdevapps">GitHub</a></p>
        <p>© 2026 Nadeem Dev Apps</p>
      </div>
      <div class="foot-wordmark" role="img" aria-label="NADEEM"><span class="foot-letter" tabindex="0">N<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span><span class="foot-letter" tabindex="0">A<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span><span class="foot-letter" tabindex="0">D<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span><span class="foot-letter" tabindex="0">E<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span><span class="foot-letter" tabindex="0">E<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span><span class="foot-letter" tabindex="0">M<i class="pt tl"></i><i class="pt tr"></i><i class="pt bl"></i><i class="pt br"></i></span></div>
    </footer>
    )}

    <script is:inline>
      // Card tilt — ported from the redesign mockup. Runs only with a fine
      // pointer and no reduced-motion request.
      (function () {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const hoverable = window.matchMedia('(hover: hover)').matches;
        if (!reduce && hoverable) {
          document.querySelectorAll('[data-tilt]').forEach(function (card) {
            card.addEventListener('mousemove', function (e) {
              const r = card.getBoundingClientRect();
              const x = (e.clientX - r.left) / r.width - 0.5;
              const y = (e.clientY - r.top) / r.height - 0.5;
              card.style.transform =
                'perspective(900px) rotateX(' + (-y * 4).toFixed(2) + 'deg) rotateY(' +
                (x * 4).toFixed(2) + 'deg) translateY(-5px)';
            });
            card.addEventListener('mouseleave', function () {
              card.style.transform = '';
            });
          });
        }
      })();

      // Footer wordmark — touch support (audit L7): a tap toggles the
      // same lit state hover/focus shows; tapping another letter moves
      // it, tapping the lit letter again turns it off.
      (function () {
        const letters = document.querySelectorAll('.foot-letter');
        letters.forEach(function (letter) {
          letter.addEventListener('click', function () {
            const wasLit = letter.classList.contains('is-lit');
            letters.forEach(function (l) { l.classList.remove('is-lit'); });
            if (!wasLit) letter.classList.add('is-lit');
          });
        });
      })();
    </script>
    <style>
      /* Skip link: visually hidden until focused (WCAG 2.4.1). */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1rem;
        border-radius: 0 0 8px 0;
        background: var(--color-primary);
        color: var(--color-on-primary);
        font-weight: 600;
        text-decoration: none;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
