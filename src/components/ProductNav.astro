---
// Product header: the product sub-site's own navigation. Each product is
// an independent site — this header (with its own theme toggle) replaces
// the main site header on product pages. Keeps the product's pages together
// and links back to the full product list and to the main website.
interface Props {
  productName: string;
  productBase: string; // e.g. `${base}products/tsumly/`
}

const { productName, productBase } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="product-nav">
  <div class="container">
    <div class="product-nav-scroll">
      <a class="product-nav-back" href={`${base}products/`}>← All Products</a>
      <span class="product-nav-name">{productName}</span>
      <nav aria-label={`${productName} pages`}>
        <a href={productBase}>Overview</a>
        <a href={`${productBase}privacy/`}>Privacy</a>
        <a href={`${productBase}terms/`}>Terms</a>
        <a href={base}>Main website</a>
      </nav>
    </div>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false">
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 1v2 M12 21v2 M4.22 4.22l1.42 1.42 M18.36 18.36l1.42 1.42 M1 12h2 M21 12h2 M4.22 19.78l1.42-1.42 M18.36 5.64l1.42-1.42" /></svg>
    </button>
  </div>
</header>

<style>
  .product-nav {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-hairline);
  }
  .product-nav .container {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    min-height: 52px;
  }
  .product-nav-back {
    color: var(--color-ink-muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .product-nav-back:hover { color: var(--color-primary); text-decoration: none; }
  .product-nav-name {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--color-ink);
  }
  .product-nav nav {
    display: flex;
    gap: var(--space-lg);
    margin-left: auto;
  }
  .product-nav nav a {
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .product-nav nav a:hover { color: var(--color-primary); text-decoration: none; }
  .product-nav-scroll {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    /* Grow to fill the header: the nav's margin-left:auto then pushes the
       page links to the right edge, and the theme toggle sits at the far
       right — mirroring the main site header. Without this the whole row
       was content-width and the right half of the header sat empty. */
    flex: 1 1 0;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .product-nav .theme-toggle { flex: none; }
  .product-nav-scroll::-webkit-scrollbar { display: none; }
  @media (max-width: 840px) {
    /* Fade at the right edge hints the row scrolls; the theme toggle sits
       outside the scrollable row, so it stays reachable at 360px. */
    .product-nav-scroll {
      mask-image: linear-gradient(to right, #000 88%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, #000 88%, transparent 100%);
    }
    .product-nav-back, .product-nav-name, .product-nav nav { flex: none; }
  }
</style>
