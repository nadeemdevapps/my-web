---
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <rect x="10" y="34" width="20" height="20" rx="6" fill="#0075de" />
  <rect x="22" y="22" width="20" height="20" rx="6" fill="#6C4DE6" />
  <rect x="34" y="10" width="20" height="20" rx="6" fill="#F2A81D" />
</svg>
