---
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <rect x="8" y="8" width="48" height="48" rx="14" fill="none" stroke="currentColor" stroke-width="3" />
  <rect x="20" y="40" width="24" height="5" rx="2.5" fill="currentColor" />
  <rect x="23" y="31" width="18" height="5" rx="2.5" fill="currentColor" />
  <rect x="26" y="22" width="12" height="5" rx="2.5" fill="currentColor" />
</svg>
