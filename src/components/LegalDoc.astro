---
interface Props {
  title: string;
  intro: string;
  sections: { heading: string; body: string }[];
}

const { title, intro, sections } = Astro.props;
---

<section>
  <div class="container narrow">
    <h1>{title}</h1>
    <p class="legal-intro">{intro}</p>
    {
      sections.map((s) => (
        <div class="legal-section">
          <h2>{s.heading}</h2>
          <p>{s.body}</p>
        </div>
      ))
    }
  </div>
</section>
